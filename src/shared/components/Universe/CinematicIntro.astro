<script is:inline>
(function () {
  const intro = document.querySelector("[data-cinematic-intro]");
  if (!intro) return;

  const status = intro.querySelector("[data-intro-status]");
  const code = intro.querySelector("[data-intro-code]");
  const skip = intro.querySelector("[data-intro-skip]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let finished = false;
  let pageReady = document.readyState === "interactive" || document.readyState === "complete";
  let whiteStageStarted = false;
  const timers = [];

  const setStage = (name, statusText, codeText) => {
    if (finished) return;
    intro.classList.remove("phase-ship", "phase-door", "phase-bot", "phase-dock", "phase-white", "phase-ready");
    intro.classList.remove("is-waiting");
    intro.classList.add(name);
    if (status) status.textContent = statusText;
    if (code) code.textContent = codeText;
  };

  const later = (fn, ms) => timers.push(window.setTimeout(fn, ms));

  const finish = () => {
    if (finished) return;
    finished = true;
    intro.classList.remove("is-waiting");
    intro.classList.add("phase-ready");
    window.dispatchEvent(new CustomEvent("guruverse:intro-reveal"));
    window.setTimeout(() => intro.classList.add("is-complete"), 700);
    window.setTimeout(() => intro.remove(), 1600);
  };

  const startWhiteTransition = () => {
    if (finished || whiteStageStarted || !pageReady) return;
    whiteStageStarted = true;
    setStage("phase-white", "UNIVERSE ONLINE", "05 / 100 PERCENT");
    later(finish, 1200);
  };

  const onReady = () => {
    pageReady = true;
    if (performance.now() >= 8050) startWhiteTransition();
  };

  if (reduce) {
    setStage("phase-ready", "SYSTEM READY", "REDUCED MOTION");
    later(finish, 700);
  } else {
    setStage("phase-ship", "VESSEL APPROACHING", "01 / FAR ORBIT");
    later(() => setStage("phase-door", "VESSEL LOCKED / DOOR OPEN", "02 / IDENTITY TRANSFER"), 3200);
    later(() => setStage("phase-bot", "GURU-BOT EMERGING", "03 / INTELLIGENCE CORE"), 4700);
    later(() => setStage("phase-dock", "RETURNING TO DOCK 01", "04 / CHARGING"), 6250);
    later(() => {
      if (pageReady) {
        startWhiteTransition();
      } else {
        intro.classList.add("is-waiting");
        if (status) status.textContent = "SYNCHRONISING / HOLDING FOR PAGE";
        if (code) code.textContent = "04 / READY GATE";
      }
    }, 8050);
    later(() => {
      if (pageReady) startWhiteTransition();
      else {
        intro.classList.add("is-waiting");
        if (status) status.textContent = "SYNCHRONISING / HOLDING FOR PAGE";
        if (code) code.textContent = "04 / READY GATE";
      }
    }, 9050);
  }

  const onKey = (event) => {
    if (event.key === "Escape") finish();
  };

  skip && skip.addEventListener("click", finish);
  window.addEventListener("keydown", onKey);
  if (pageReady) {
    window.setTimeout(onReady, 0);
  } else {
    window.addEventListener("DOMContentLoaded", onReady, { once: true });
  }
})();
</script>