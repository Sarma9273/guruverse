---
const base = import.meta.env.BASE_URL;
---
<div class="gv-intro" data-cinematic-intro aria-label="GURUVERSE cinematic identity sequence">
  <div class="gv-camera" aria-hidden="true">
    <div class="gv-stars gv-stars--far"></div>
    <div class="gv-stars gv-stars--near"></div>
    <div class="gv-nebula"></div>
    <div class="gv-orbit gv-orbit--a"></div>
    <div class="gv-orbit gv-orbit--b"></div>
    <div class="gv-grid"></div>
    <div class="gv-data-field">
      <span>01001101</span><span>00110110</span><span>10100101</span><span>01101001</span><span>11001010</span>
      <span>00010111</span><span>10111001</span><span>01001010</span><span>11100100</span><span>00101101</span>
      <span>10010110</span><span>01011100</span><span>11010001</span><span>00111010</span><span>10101110</span>
    </div>
  </div>

  <div class="gv-hud gv-hud--tl" aria-hidden="true">
    <b>GURUVERSE / SYS-01</b><span>ENGINEERING UNIVERSE</span>
  </div>
  <div class="gv-hud gv-hud--tr" aria-hidden="true">
    <b data-intro-stage>BOOT</b><span data-intro-code>00 / INITIALISE</span>
  </div>
  <div class="gv-hud gv-hud--bl" aria-hidden="true">
    <b>IDENTITY CHANNEL</b><span>SECURE · LOCAL · ACTIVE</span>
  </div>

  <div class="gv-center" aria-hidden="true">
    <div class="gv-center__reticle"></div>
    <div class="gv-center__core"></div>
    <div class="gv-center__label"><span data-intro-status>ESTABLISHING UNIVERSE</span><i></i></div>
  </div>

  <div class="gv-title" aria-hidden="true">
    <span>GURUVERSE / ENGINEERING UNIVERSE</span>
    <strong>ENTERING</strong>
    <b>GURUVERSE</b>
  </div>

  <div class="gv-flash" aria-hidden="true"></div>
  <button class="gv-skip" type="button" data-intro-skip>SKIP <kbd>ESC</kbd></button>
</div>

<style is:inline>
.gv-intro{position:fixed;inset:0;z-index:var(--z-loader);overflow:hidden;background:#010307;color:#eefcff;isolation:isolate;perspective:1400px;opacity:1;visibility:visible;pointer-events:auto;transition:background .9s ease,opacity .9s ease}
.gv-intro.is-complete{opacity:0;visibility:hidden;pointer-events:none}
.gv-camera{position:absolute;inset:-12%;transform-style:preserve-3d;will-change:transform;transition:transform 1.4s cubic-bezier(.2,.8,.2,1)}
.gv-stars,.gv-nebula,.gv-grid,.gv-data-field{position:absolute;inset:0;pointer-events:none}
.gv-stars{background-repeat:repeat;mix-blend-mode:screen}
.gv-stars--far{opacity:.35;background-image:radial-gradient(circle,rgba(225,250,255,.8) 0 .8px,transparent 1.2px);background-size:126px 126px;animation:gv-drift-far 30s linear infinite}
.gv-stars--near{opacity:.65;background-image:radial-gradient(circle,rgba(0,229,255,.8) 0 .9px,transparent 1.4px);background-size:210px 190px;background-position:40px 60px;animation:gv-drift-near 16s linear infinite}
.gv-nebula{background:radial-gradient(circle at 52% 48%,rgba(0,229,255,.1),transparent 18%),radial-gradient(circle at 76% 35%,rgba(124,77,255,.11),transparent 35%),radial-gradient(circle at 20% 75%,rgba(0,255,163,.05),transparent 28%);filter:blur(3px)}
.gv-grid{opacity:.08;background-image:linear-gradient(rgba(155,225,232,.32) 1px,transparent 1px),linear-gradient(90deg,rgba(155,225,232,.32) 1px,transparent 1px);background-size:78px 78px;transform:perspective(650px) rotateX(67deg) scale(1.65);transform-origin:50% 78%;mask-image:linear-gradient(transparent,#000 28%,#000 72%,transparent)}
.gv-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(0,229,255,.18);border-radius:50%;transform-style:preserve-3d;transform:translate(-50%,-50%) rotateX(68deg) rotate(-18deg);box-shadow:0 0 35px rgba(0,229,255,.035)}
.gv-orbit--a{width:74vw;max-width:1100px;aspect-ratio:1;animation:gv-orbit-a 22s linear infinite}
.gv-orbit--b{width:46vw;max-width:700px;aspect-ratio:1;border-color:rgba(124,77,255,.22);transform:translate(-50%,-50%) rotateX(62deg) rotate(62deg);animation:gv-orbit-b 17s linear infinite reverse}
.gv-data-field{opacity:0;display:grid;grid-template-columns:repeat(5,1fr);align-content:center;gap:1.8rem;padding:12vh 8vw;color:rgba(0,229,255,.3);font:600 clamp(.45rem,.7vw,.7rem)/1 var(--font-code);letter-spacing:.2em;mask-image:radial-gradient(ellipse at center,#000,transparent 72%);transition:opacity .8s ease;transform:translateZ(20px)}
.gv-hud{position:absolute;z-index:20;display:grid;gap:.35rem;font:600 .52rem/1.2 var(--font-code);letter-spacing:.15em;text-transform:uppercase;color:rgba(220,245,249,.3)}
.gv-hud b{color:rgba(220,245,249,.72)}.gv-hud span{font-size:.42rem;color:rgba(220,245,249,.22)}
.gv-hud--tl{left:4vw;top:4vh}.gv-hud--tr{right:4vw;top:4vh;text-align:right}.gv-hud--bl{left:4vw;bottom:4vh}
.gv-center{position:absolute;z-index:10;left:50%;top:50%;width:min(48vw,620px);aspect-ratio:1;transform:translate(-50%,-50%) scale(.55);opacity:0;transition:opacity .9s ease,transform 1.4s cubic-bezier(.16,1,.3,1);pointer-events:none}
.gv-center__reticle{position:absolute;inset:9%;border:1px solid rgba(0,229,255,.2);border-radius:50%;transform:rotateX(68deg);box-shadow:0 0 70px rgba(0,229,255,.08)}
.gv-center__reticle:before,.gv-center__reticle:after{content:"";position:absolute;left:50%;top:50%;background:rgba(0,229,255,.35);transform:translate(-50%,-50%)}
.gv-center__reticle:before{width:75%;height:1px}.gv-center__reticle:after{width:1px;height:75%}
.gv-center__core{position:absolute;inset:43%;border:1px solid rgba(236,255,255,.8);border-radius:50%;box-shadow:0 0 40px rgba(0,229,255,.45),inset 0 0 18px rgba(0,229,255,.2);animation:gv-core-pulse 2s ease-in-out infinite}
.gv-center__label{position:absolute;left:50%;top:72%;transform:translateX(-50%);display:flex;align-items:center;gap:.7rem;white-space:nowrap;color:rgba(221,249,252,.45);font:600 .48rem var(--font-code);letter-spacing:.16em}
.gv-center__label i{width:34px;height:1px;background:rgba(0,229,255,.65)}
.gv-title{position:absolute;z-index:21;left:7vw;top:50%;transform:translateY(-50%);display:grid;gap:.55rem;opacity:0;transition:opacity .8s ease,transform 1s cubic-bezier(.16,1,.3,1);pointer-events:none}
.gv-title span{color:rgba(220,245,249,.4);font:600 .55rem var(--font-code);letter-spacing:.2em}
.gv-title strong,.gv-title b{display:block;font:700 clamp(3.2rem,8vw,8.6rem)/.78 var(--font-display);letter-spacing:-.08em;text-transform:uppercase}
.gv-title strong{color:#eefcff}.gv-title b{color:#bffaff;text-shadow:0 0 55px rgba(0,229,255,.14)}
.gv-flash{position:absolute;inset:0;z-index:30;background:#fff;opacity:0;pointer-events:none;transform:scale(.9)}
.gv-skip{position:absolute;z-index:50;right:4vw;bottom:4vh;border:0;background:none;color:rgba(236,255,255,.32);font:600 .48rem var(--font-code);letter-spacing:.15em;cursor:pointer}
.gv-skip kbd{margin-left:.45rem;color:rgba(0,229,255,.7);font:inherit}

/* State choreography */
.gv-intro.phase-universe .gv-camera{animation:gv-camera-push 3.8s cubic-bezier(.16,.72,.2,1) forwards}
.gv-intro.phase-universe .gv-center{opacity:1;transform:translate(-50%,-50%) scale(1)}
.gv-intro.phase-universe .gv-data-field{opacity:1}
.gv-intro.phase-universe .gv-title{opacity:1;transform:translateY(-50%) translateX(0)}
.gv-intro.phase-portrait{background:transparent}
.gv-intro.phase-portrait .gv-camera>*:not(.gv-data-field){opacity:0}
.gv-intro.phase-portrait .gv-data-field{opacity:.12}
.gv-intro.phase-portrait .gv-center{opacity:.2;transform:translate(-50%,-50%) scale(1.08)}
.gv-intro.phase-portrait .gv-title{opacity:0}
.gv-intro.phase-scan,.gv-intro.phase-verified,.gv-intro.phase-lock{background:transparent}
.gv-intro.phase-scan .gv-camera>*:not(.gv-data-field){opacity:0}
.gv-intro.phase-verified .gv-camera,.gv-intro.phase-lock .gv-camera{opacity:0}
.gv-intro.phase-verified .gv-flash{animation:gv-verify-flash .7s ease forwards}
.gv-intro.phase-lock .gv-flash{animation:gv-lock-flash .9s ease forwards}
.gv-intro.phase-lock .gv-title{opacity:1;transform:translateY(-50%) translateX(0)}
.gv-intro.phase-lock .gv-skip{opacity:0;pointer-events:none}
@keyframes gv-camera-push{0%{transform:translate3d(0,0,0) scale(.98)}45%{transform:translate3d(-1.5%,-1%,0) scale(1.08)}100%{transform:translate3d(2%,1%,0) scale(1.16)}}
@keyframes gv-drift-far{to{background-position:126px 126px}}
@keyframes gv-drift-near{to{background-position:-120px 140px}}
@keyframes gv-orbit-a{to{transform:translate(-50%,-50%) rotateX(68deg) rotate(342deg)}}
@keyframes gv-orbit-b{to{transform:translate(-50%,-50%) rotateX(62deg) rotate(-298deg)}}
@keyframes gv-core-pulse{0%,100%{transform:scale(.82);opacity:.6}50%{transform:scale(1.18);opacity:1}}
@keyframes gv-verify-flash{0%{opacity:0}25%{opacity:.18}100%{opacity:0}}
@keyframes gv-lock-flash{0%{opacity:0}20%{opacity:.22}100%{opacity:0}}
@media(max-width:700px){
  .gv-title{left:1rem}.gv-title strong,.gv-title b{font-size:clamp(2.8rem,14vw,5.5rem)}
  .gv-hud--tr,.gv-hud--bl{display:none}.gv-data-field{grid-template-columns:repeat(3,1fr);gap:1rem;padding:10vh 4vw}
  .gv-center{width:82vw}.gv-skip{right:1rem;bottom:1.4rem}
}
@media(prefers-reduced-motion:reduce){
  .gv-stars,.gv-orbit,.gv-center__core,.gv-camera{animation:none!important}
  .gv-intro.phase-universe .gv-camera{transform:none}
  .gv-intro.phase-universe .gv-center{opacity:1;transform:translate(-50%,-50%) scale(1)}
}
</style>

<script is:inline>
(function(){
  const intro=document.querySelector("[data-cinematic-intro]");
  if(!intro)return;
  const status=intro.querySelector("[data-intro-status]");
  const stage=intro.querySelector("[data-intro-stage]");
  const code=intro.querySelector("[data-intro-code]");
  const skip=intro.querySelector("[data-intro-skip]");
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const seen=(()=>{try{return sessionStorage.getItem("guruverse-intro-seen-v3")==="true"}catch{return false}})();
  let done=false;
  const timers=[];
  const later=(fn,ms)=>timers.push(window.setTimeout(fn,ms));
  const emit=(name)=>window.dispatchEvent(new CustomEvent(name));

  function setState(className,label,codeText){
    intro.classList.remove("phase-universe","phase-portrait","phase-scan","phase-verified","phase-lock");
    intro.classList.add(className);
    if(status)status.textContent=label;
    if(stage)stage.textContent=className.replace("phase-","").toUpperCase();
    if(code)code.textContent=codeText;
  }

  function finish(){
    if(done)return;
    done=true;
    timers.forEach(clearTimeout);
    emit("guruverse:intro-complete");
    intro.classList.add("is-complete");
    try{sessionStorage.setItem("guruverse-intro-seen-v3","true")}catch{}
    window.setTimeout(()=>intro.remove(),950);
  }

  function run(){
    if(reduce||seen){
      setState("phase-lock","SYSTEM READY","06 / ONLINE");
      emit("guruverse:hero-lock");
      later(finish,450);
      return;
    }
    setState("phase-universe","CAMERA / UNIVERSE ESTABLISHED","01 / GALAXY");
    emit("guruverse:universe-motion");
    later(()=>{
      setState("phase-portrait","ACQUIRING SUBJECT / PARTICLE FIELD","02 / PORTRAIT");
      emit("guruverse:portrait-build-start");
    },2200);
    later(()=>{
      setState("phase-scan","IDENTITY SCAN / RESOLUTION","03 / SCANNER");
      emit("guruverse:identity-scan");
    },4700);
    later(()=>{
      setState("phase-verified","IDENTITY VERIFIED / GURU CHARAN","04 / VERIFIED");
      emit("guruverse:identity-verified");
    },5900);
    later(()=>{
      setState("phase-lock","HERO LOCK / CAPABILITIES ONLINE","05 / HERO");
      emit("guruverse:hero-lock");
    },6750);
    later(finish,8250);
  }

  skip?.addEventListener("click",()=>{setState("phase-lock","SYSTEM READY","SKIPPED");emit("guruverse:hero-lock");later(finish,350)});
  window.addEventListener("keydown",(e)=>{if(e.key==="Escape")skip?.click()});
  requestAnimationFrame(run);
})();
</script>