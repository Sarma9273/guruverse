const intro=document.querySelector<HTMLElement>("[data-cinematic-intro]");
if(intro){
  const status=intro.querySelector<HTMLElement>("[data-intro-status]");
  const code=intro.querySelector<HTMLElement>("[data-intro-code]");
  const skip=intro.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let finished=false;
  const setStage=(className:string,statusText:string,codeText:string)=>{
    if(finished)return;
    intro.classList.remove("phase-ship","phase-core","phase-bot","phase-dock","phase-ready");
    intro.classList.add(className);
    if(status)status.textContent=statusText;
    if(code)code.textContent=codeText;
  };
  const finish=()=>{
    if(finished)return;
    finished=true;
    intro.classList.add("phase-ready");
    window.dispatchEvent(new CustomEvent("guruverse:intro-reveal"));
    window.setTimeout(()=>intro.classList.add("is-complete"),620);
    window.setTimeout(()=>intro.remove(),1550);
  };
  const timers:number[]=[];
  const later=(fn:()=>void,ms:number)=>timers.push(window.setTimeout(fn,ms));
  const cleanup=()=>timers.forEach(window.clearTimeout);
  if(reduce){
    setStage("phase-ready","SYSTEM READY","REDUCED MOTION");
    window.setTimeout(finish,900);
  }else{
    setStage("phase-ship","SHIP SIGNAL ACQUIRED","VECTOR 01 · VESSEL");
    later(()=>setStage("phase-core","IDENTITY CORE FORMING","VECTOR 02 · CORE"),2750);
    later(()=>setStage("phase-bot","INTELLIGENCE CORE ONLINE","VECTOR 03 · GURU-BOT"),4050);
    later(()=>setStage("phase-dock","DOCKING SEQUENCE","VECTOR 04 · DOCK 01"),5700);
    later(()=>setStage("phase-ready","GURU-BOT DOCKED","SYSTEM READY"),8050);
    later(finish,8550);
  }
  const onKey=(event:KeyboardEvent)=>{if(event.key==="Escape")finish()};
  skip?.addEventListener("click",finish);
  window.addEventListener("keydown",onKey);
  window.addEventListener("pagehide",cleanup,{once:true});
}
</script>
