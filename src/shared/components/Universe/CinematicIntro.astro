---
---
<div class="gv-loader" data-cinematic-intro aria-label="GURUVERSE cinematic boot sequence">
  <div class="gv-loader__space"></div>
  <div class="gv-loader__brand">GURUVERSE <span>/ BOOT PROTOCOL</span></div>
  <div class="gv-loader__readout"><strong data-stage>INITIALISING</strong><span data-code>01 / SYSTEM</span></div>

  <div class="gv-loader__core" aria-hidden="true">
    <span class="gv-loader__orbit gv-loader__orbit--outer"></span>
    <span class="gv-loader__orbit gv-loader__orbit--mid"></span>
    <span class="gv-loader__orbit gv-loader__orbit--inner"></span>
    <span class="gv-loader__cross gv-loader__cross--h"></span>
    <span class="gv-loader__cross gv-loader__cross--v"></span>
    <span class="gv-loader__core-light"></span>
    <div class="gv-loader__scan"></div>
  </div>

  <div class="gv-loader__copy">
    <small>IDENTITY SYSTEM</small>
    <strong data-status>BOOTING</strong>
    <span>GURU-BOT / INTELLIGENCE CORE</span>
  </div>

  <div class="gv-loader__progress">
    <div><span>GURUVERSE INITIALISATION</span><strong data-value>0%</strong></div>
    <i><b data-bar></b></i>
  </div>

  <button class="gv-loader__skip" type="button" data-intro-skip>SKIP <kbd>ESC</kbd></button>
</div>

<style is:inline>
.gv-loader{position:fixed;inset:0;z-index:var(--z-loader);overflow:hidden;background:#02050a;color:#effdff;isolation:isolate;opacity:1;visibility:visible;pointer-events:auto}
.gv-loader.is-complete{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .7s ease,visibility 0s linear .7s}
.gv-loader__space{position:absolute;inset:0;background:
 radial-gradient(circle at 50% 50%,rgba(0,229,255,.07),transparent 22%),
 radial-gradient(circle at 50% 52%,rgba(124,77,255,.05),transparent 43%),
 linear-gradient(180deg,#010308,#03101a 52%,#010307)}
.gv-loader__space:before{content:"";position:absolute;inset:0;opacity:.3;background-image:radial-gradient(circle,rgba(210,250,255,.7) 0 1px,transparent 1.5px);background-size:87px 87px;animation:gv-stars 16s linear infinite}
.gv-loader__brand,.gv-loader__readout{position:absolute;top:4vh;z-index:8;font:600 .55rem/1.3 var(--font-code);letter-spacing:.18em;text-transform:uppercase}
.gv-loader__brand{left:4vw;color:rgba(225,250,255,.8)}
.gv-loader__brand span{color:rgba(225,250,255,.3)}
.gv-loader__readout{right:4vw;text-align:right;display:grid;gap:.25rem;color:rgba(225,250,255,.3)}
.gv-loader__readout strong{color:#baf7ff}.gv-loader__readout span{font-size:.42rem}
.gv-loader__core{position:absolute;left:50%;top:50%;width:min(58vw,520px);height:min(58vw,520px);transform:translate(-50%,-50%);z-index:3;border-radius:50%;display:grid;place-items:center}
.gv-loader__orbit{position:absolute;border-radius:50%;border:1px solid rgba(100,230,255,.34);box-shadow:0 0 25px rgba(0,229,255,.06),inset 0 0 25px rgba(0,229,255,.04)}
.gv-loader__orbit--outer{inset:0;border-style:solid;animation:gv-spin 18s linear infinite}
.gv-loader__orbit--mid{inset:9%;border-color:rgba(124,77,255,.38);border-style:dashed;animation:gv-spin-rev 13s linear infinite}
.gv-loader__orbit--inner{inset:20%;border-color:rgba(170,245,255,.22);animation:gv-spin 8s linear infinite}
.gv-loader__cross{position:absolute;background:rgba(150,240,255,.13)}
.gv-loader__cross--h{left:-4%;right:-4%;height:1px}.gv-loader__cross--v{top:-4%;bottom:-4%;width:1px}
.gv-loader__core-light{width:24%;height:24%;border-radius:50%;background:radial-gradient(circle,#fff 0 3%,#73efff 12%,rgba(0,229,255,.2) 43%,transparent 72%);filter:drop-shadow(0 0 25px rgba(0,229,255,.8));animation:gv-pulse 2.2s ease-in-out infinite}
.gv-loader__scan{position:absolute;inset:7%;border-radius:50%;border-top:1px solid rgba(220,255,255,.65);animation:gv-scan 2.6s linear infinite}
.gv-loader__copy{position:absolute;z-index:8;left:50%;top:calc(50% + min(30vw,270px));transform:translateX(-50%);text-align:center;display:grid;gap:.3rem;text-transform:uppercase;pointer-events:none}
.gv-loader__copy small,.gv-loader__copy span{font:600 .45rem var(--font-code);letter-spacing:.18em;color:rgba(225,250,255,.32)}
.gv-loader__copy strong{font:700 clamp(1.1rem,2vw,1.8rem) var(--font-display);letter-spacing:.08em;color:#eaffff;text-shadow:0 0 24px rgba(0,229,255,.3)}
.gv-loader__progress{position:absolute;left:18vw;right:18vw;bottom:9vh;z-index:8}
.gv-loader__progress>div{display:flex;justify-content:space-between;margin-bottom:.5rem;font:600 .46rem var(--font-code);letter-spacing:.15em;color:rgba(225,250,255,.32)}
.gv-loader__progress strong{color:#c9fbff}.gv-loader__progress>i{display:block;height:2px;background:rgba(225,250,255,.12);overflow:hidden}.gv-loader__progress>i b{display:block;width:0;height:100%;background:linear-gradient(90deg,#00bcd4,#eaffff,#7c4dff);box-shadow:0 0 18px rgba(0,229,255,.7)}
.gv-loader__skip{position:absolute;right:4vw;bottom:4vh;z-index:10;border:0;background:none;color:rgba(236,255,255,.3);font:600 .48rem var(--font-code);letter-spacing:.15em;cursor:pointer}.gv-loader__skip kbd{margin-left:.4rem;color:#72efff;font:inherit}
.gv-loader.phase-white .gv-loader__space,.gv-loader.phase-white .gv-loader__core,.gv-loader.phase-white .gv-loader__brand,.gv-loader.phase-white .gv-loader__readout,.gv-loader.phase-white .gv-loader__copy,.gv-loader.phase-white .gv-loader__progress{opacity:0;transition:opacity .28s ease}
.gv-loader.phase-white:after{content:"";position:absolute;inset:-10%;z-index:9;background:radial-gradient(circle at 50% 50%,#fff 0,rgba(255,255,255,.97) 25%,rgba(255,255,255,.72) 50%,rgba(255,255,255,.18) 72%,transparent 84%);animation:gv-whiteout 1.8s cubic-bezier(.22,.61,.36,1) both}
@keyframes gv-stars{to{transform:translateY(87px)}}@keyframes gv-spin{to{transform:rotate(360deg)}}@keyframes gv-spin-rev{to{transform:rotate(-360deg)}}@keyframes gv-pulse{0%,100%{transform:scale(.86);opacity:.72}50%{transform:scale(1.12);opacity:1}}@keyframes gv-scan{to{transform:rotate(360deg)}}@keyframes gv-whiteout{0%{opacity:0;transform:scale(.94)}38%{opacity:.72;transform:scale(1)}72%{opacity:1;transform:scale(1.04)}100%{opacity:.88;transform:scale(1.08)}}
@media(max-width:700px){.gv-loader__core{width:min(82vw,430px);height:min(82vw,430px)}.gv-loader__copy{top:calc(50% + min(43vw,225px))}.gv-loader__progress{left:1rem;right:1rem;bottom:8vh}.gv-loader__brand{left:1rem}.gv-loader__readout{right:1rem}}
@media(prefers-reduced-motion:reduce){.gv-loader__space:before,.gv-loader__orbit,.gv-loader__core-light,.gv-loader__scan{animation:none}.gv-loader.phase-white:after{animation:none}}
</style>

<script is:inline>
(function(){
  const root=document.querySelector("[data-cinematic-intro]");
  if(!root)return;
  const status=root.querySelector("[data-status]"),stage=root.querySelector("[data-stage]"),code=root.querySelector("[data-code]");
  const value=root.querySelector("[data-value]"),bar=root.querySelector("[data-bar]"),skip=root.querySelector("[data-intro-skip]");
  const reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  let done=false;
  const later=(f,t)=>setTimeout(f,t);
  const emit=n=>dispatchEvent(new CustomEvent(n));
  function state(cls,s,c,p){root.className="gv-loader "+cls;status.textContent=s;stage.textContent=cls.replace("phase-","").toUpperCase();code.textContent=c;value.textContent=p+"%";bar.style.width=p+"%";document.documentElement.dataset.guruverseBootPhase=cls.includes("bot")?"bot":cls.includes("white")?"complete":cls.includes("reveal")?"complete":"system"}
  function finish(){if(done)return;done=true;root.classList.add("is-complete");document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");later(()=>emit("guruverse:intro-complete"),120);later(()=>root.remove(),800)}
  function run(){
    document.documentElement.classList.add("guruverse-booting");
    /* Reduced-motion disables decorative motion, not the cinematic sequence itself. The boot remains readable. */
    if(reduce){
      state("phase-system","SYSTEM INITIALISING","01 / SYSTEM",0);
      document.documentElement.dataset.guruverseBootPhase="system";
      later(()=>state("phase-core","IDENTITY CORE ONLINE","02 / CORE",28),2600);
      later(()=>{state("phase-bot","GURU-BOT STANDING BY","03 / INTELLIGENCE",52);emit("guruverse:bot-emerge")},6000);
      later(()=>state("phase-bot","GURU-BOT STANDING / LOADING","04 / 78%",78),7600);
      later(()=>state("phase-bot","GURU-BOT READY / 100%","05 / COMPLETE",100),9800);
      later(()=>{state("phase-white","SYSTEM COMPLETE / REVEALING","06 / WHITEOUT",100);document.documentElement.classList.add("guruverse-whiteout");emit("guruverse:boot-whiteout")},12000);
      later(()=>{state("phase-reveal","GURUVERSE ONLINE","07 / WEBSITE",100);document.documentElement.classList.remove("guruverse-whiteout","guruverse-booting");document.documentElement.dataset.guruverseReveal="true";emit("guruverse:website-reveal-start");emit("guruverse:website-revealed");later(finish,700)},14000);
      return;
    }
    state("phase-system","SYSTEM INITIALISING","01 / SYSTEM",0);emit("guruverse:boot-start");
    later(()=>{state("phase-core","IDENTITY CORE ONLINE","02 / CORE",28)},3000);
    later(()=>{state("phase-bot","GURU-BOT STANDING BY","03 / INTELLIGENCE",52);emit("guruverse:bot-emerge")},4700);
    later(()=>{state("phase-bot","GURU-BOT STANDING / LOADING","04 / 78%",78)},9000);
    later(()=>{state("phase-bot","GURU-BOT READY / 100%","05 / COMPLETE",100)},11000);
    later(()=>{state("phase-white","SYSTEM COMPLETE / REVEALING","06 / WHITEOUT",100);document.documentElement.classList.add("guruverse-whiteout");emit("guruverse:boot-whiteout")},12000);
    later(()=>{state("phase-reveal","GURUVERSE ONLINE","07 / WEBSITE",100);document.documentElement.classList.remove("guruverse-whiteout","guruverse-booting");document.documentElement.dataset.guruverseReveal="true";document.documentElement.dataset.guruverseBootPhase="complete";emit("guruverse:website-reveal-start");emit("guruverse:website-revealed");later(finish,700)},14000);
  }
  skip?.addEventListener("click",()=>{document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");document.documentElement.dataset.guruverseReveal="true";document.documentElement.dataset.guruverseBootPhase="complete";emit("guruverse:website-revealed");finish()});
  addEventListener("keydown",e=>{if(e.key==="Escape")skip?.click()},{once:true});
  run();
})();
</script>