<div class="gv-intro" data-cinematic-intro>
  <div class="gv-intro__field"></div><div class="gv-intro__grid"></div>
  <div class="gv-intro__core"><span class="gv-intro__orbit gv-intro__orbit--outer"></span><span class="gv-intro__orbit gv-intro__orbit--inner"></span><span class="gv-intro__signal"></span></div>
  <div class="gv-intro__readout"><span>GURUVERSE // BOOT SEQUENCE</span><strong data-intro-status>INITIALISING GURUVERSE</strong><span data-intro-progress>00 — 04</span></div>
  <div class="gv-intro__identity">GURU<span>CHARAN</span></div>
  <button class="gv-intro__skip" type="button" data-intro-skip>SKIP INTRO <span>ESC</span></button>
</div>
<style>
.gv-intro{position:fixed;inset:0;z-index:var(--z-loader);display:grid;place-items:center;overflow:hidden;background:#02040a;color:#f7fbff;isolation:isolate;opacity:1;transition:opacity .65s var(--ease-cinematic),visibility .65s}.gv-intro.is-complete{opacity:0;visibility:hidden;pointer-events:none}.gv-intro__field,.gv-intro__grid{position:absolute;inset:0;pointer-events:none}.gv-intro__field{background:radial-gradient(circle at 50% 50%,rgba(0,229,255,.12),transparent 22%),radial-gradient(circle at 25% 30%,rgba(124,77,255,.08),transparent 32%),#02040a}.gv-intro__grid{opacity:.28;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(circle at center,#000 0 30%,transparent 78%)}.gv-intro__core{position:relative;width:min(34vw,360px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;filter:drop-shadow(0 0 45px rgba(0,229,255,.2))}.gv-intro__core::before,.gv-intro__core::after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.16)}.gv-intro__core::before{inset:22%;box-shadow:0 0 80px rgba(0,229,255,.12),inset 0 0 60px rgba(124,77,255,.08)}.gv-intro__core::after{inset:39%;background:radial-gradient(circle,rgba(247,251,255,.9),rgba(0,229,255,.35) 28%,transparent 68%);border-color:rgba(0,229,255,.6);animation:gv-intro-pulse 1.4s ease-in-out infinite}.gv-intro__orbit{position:absolute;border:1px solid rgba(0,229,255,.28);border-radius:50%;transform:rotate(-22deg) rotateX(65deg);animation:gv-intro-spin 2.8s linear infinite}.gv-intro__orbit--outer{inset:-2%;border-color:rgba(124,77,255,.28)}.gv-intro__orbit--inner{inset:14%;transform:rotate(28deg) rotateX(68deg);animation-duration:2.1s;animation-direction:reverse}.gv-intro__signal{width:7px;height:7px;border-radius:50%;background:#dffcff;box-shadow:0 0 20px 5px rgba(0,229,255,.6)}.gv-intro__readout{position:absolute;left:clamp(1rem,5vw,5rem);bottom:clamp(1rem,5vw,4rem);display:grid;gap:.35rem;font:500 .68rem/1.3 var(--font-code);letter-spacing:.16em;text-transform:uppercase;color:rgba(247,251,255,.58)}.gv-intro__readout strong{color:#dffcff;font-size:clamp(.78rem,1.2vw,1rem);letter-spacing:.11em}.gv-intro__identity{position:absolute;right:clamp(1rem,5vw,5rem);top:clamp(1rem,5vw,4rem);font:700 clamp(.8rem,1.2vw,1rem)/1 var(--font-display);letter-spacing:.2em}.gv-intro__identity span{display:block;color:rgba(0,229,255,.65);font-size:.62em;margin-top:.6em;letter-spacing:.35em}.gv-intro__skip{position:absolute;right:clamp(1rem,5vw,5rem);bottom:clamp(1rem,5vw,4rem);padding:.65rem .8rem;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:rgba(247,251,255,.65);font:600 .65rem/1 var(--font-code);letter-spacing:.12em;background:rgba(255,255,255,.025);cursor:pointer;transition:color .2s,border-color .2s,background .2s}.gv-intro__skip:hover,.gv-intro__skip:focus-visible{color:#fff;border-color:rgba(0,229,255,.5);background:rgba(0,229,255,.06)}.gv-intro__skip span{margin-left:.55rem;opacity:.5}@keyframes gv-intro-spin{to{transform:rotate(338deg) rotateX(65deg)}}@keyframes gv-intro-pulse{50%{transform:scale(1.18);opacity:.72}}@media(max-width:640px){.gv-intro__core{width:58vw}.gv-intro__readout{bottom:1rem;left:1rem}.gv-intro__skip{right:1rem;bottom:4.4rem}.gv-intro__identity{top:1rem;right:1rem}}@media(prefers-reduced-motion:reduce){.gv-intro{transition-duration:.1s}.gv-intro__orbit,.gv-intro__core::after{animation:none}.gv-intro__core::after{opacity:.8}}
</style>
<script>
const intro=document.querySelector<HTMLElement>("[data-cinematic-intro]");
if(intro){const skip=intro.querySelector<HTMLButtonElement>("[data-intro-skip]"),status=intro.querySelector<HTMLElement>("[data-intro-status]"),progress=intro.querySelector<HTMLElement>("[data-intro-progress]"),reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches,seen=sessionStorage.getItem("guruverse-intro-seen")==="1";const stages=["INITIALISING GURUVERSE","IDENTITY SIGNAL DETECTED","ENGINEERING ARCHIVE CONNECTED","GURUVERSE READY"];let timer:number|undefined,stage=0;const finish=()=>{if(timer)window.clearInterval(timer);sessionStorage.setItem("guruverse-intro-seen","1");intro.classList.add("is-complete");window.setTimeout(()=>intro.remove(),700)};if(seen||reduce)finish();else{timer=window.setInterval(()=>{stage++;if(stage>=stages.length)return finish();if(status)status.textContent=stages[stage];if(progress)progress.textContent=String(stage).padStart(2,"0")+" — 04"},650);window.setTimeout(finish,2900)}skip?.addEventListener("click",finish);window.addEventListener("keydown",e=>{if(e.key==="Escape")finish()})}
</script>