---
---
<div class="gv-intro" data-cinematic-intro aria-label="GURUVERSE cinematic arrival sequence">
  <div class="gv-space" aria-hidden="true">
    <div class="gv-stars gv-stars--far"></div>
    <div class="gv-stars gv-stars--near"></div>
    <div class="gv-nebula"></div>
    <div class="gv-grid"></div>
    <div class="gv-vignette"></div>
    <div class="gv-scanlines"></div>
  </div>

  <div class="gv-origin" aria-hidden="true">
    <span class="gv-origin__planet"></span>
    <span class="gv-origin__label">FAR ORBIT / ORIGIN</span>
  </div>

  <div class="gv-hud gv-hud--tl" aria-hidden="true">
    <b>GURUVERSE / SYS-01</b>
    <span>IDENTITY ARRIVAL PROTOCOL</span>
  </div>
  <div class="gv-hud gv-hud--tr" aria-hidden="true">
    <b data-intro-stage>ARRIVAL</b>
    <span data-intro-code>00 / 000%</span>
  </div>
  <div class="gv-hud gv-hud--bl" aria-hidden="true">
    <b data-intro-status>ESTABLISHING LONG-RANGE LINK</b>
    <span>VESSEL · IDENTITY CORE · GURU-BOT</span>
  </div>

  <div class="gv-title" aria-hidden="true">
    <span>GURUVERSE // ENGINEERING UNIVERSE</span>
    <strong>INITIALISING</strong>
    <b>IDENTITY SYSTEM</b>
  </div>

  <div class="gv-ship" aria-hidden="true">
    <span class="gv-ship__trail"></span>
    <span class="gv-ship__body">
      <span class="gv-ship__nose"></span>
      <span class="gv-ship__cockpit"></span>
      <span class="gv-ship__wing gv-ship__wing--l"></span>
      <span class="gv-ship__wing gv-ship__wing--r"></span>
      <span class="gv-ship__engine gv-ship__engine--l"></span>
      <span class="gv-ship__engine gv-ship__engine--r"></span>
      <span class="gv-ship__door">
        <i></i>
        <b>IDENTITY BAY</b>
      </span>
    </span>
    <span class="gv-ship__glow"></span>
  </div>

  <div class="gv-arrival-core" aria-hidden="true">
    <span class="gv-arrival-core__ring gv-arrival-core__ring--a"></span>
    <span class="gv-arrival-core__ring gv-arrival-core__ring--b"></span>
    <span class="gv-arrival-core__cross"></span>
    <span class="gv-arrival-core__energy"></span>
    <span class="gv-arrival-core__label">IDENTITY TRANSFER</span>
  </div>

  <div class="gv-progress" aria-hidden="true">
    <div class="gv-progress__meta">
      <span>BOOT SEQUENCE</span>
      <b data-progress-value>0%</b>
    </div>
    <div class="gv-progress__track"><i data-progress-bar></i></div>
    <div class="gv-progress__ticks"><span>00</span><span>25</span><span>50</span><span>75</span><span>100</span></div>
  </div>

  <div class="gv-cloud" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="gv-whiteout" aria-hidden="true"></div>

  <button class="gv-skip" type="button" data-intro-skip>SKIP <kbd>ESC</kbd></button>
</div>

<style is:inline>
.gv-intro{position:fixed;inset:0;z-index:var(--z-loader);overflow:hidden;background:#010307;color:#effcff;isolation:isolate;opacity:1;visibility:visible;pointer-events:auto}
.gv-intro.is-complete{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .65s ease,visibility 0s linear .65s}
.gv-space,.gv-stars,.gv-nebula,.gv-grid,.gv-vignette,.gv-scanlines{position:absolute;inset:0;pointer-events:none}
.gv-space{overflow:hidden;background:radial-gradient(circle at 52% 48%,rgba(0,229,255,.07),transparent 22%),radial-gradient(circle at 74% 22%,rgba(124,77,255,.09),transparent 34%),#010307}
.gv-stars{background-repeat:repeat;mix-blend-mode:screen}
.gv-stars--far{opacity:.42;background-image:radial-gradient(circle,rgba(231,251,255,.8) 0 .8px,transparent 1.15px);background-size:137px 137px;animation:gv-stars-far 32s linear infinite}
.gv-stars--near{opacity:.62;background-image:radial-gradient(circle,rgba(0,229,255,.8) 0 .85px,transparent 1.3px);background-size:191px 179px;background-position:42px 63px;animation:gv-stars-near 18s linear infinite}
.gv-nebula{background:radial-gradient(ellipse at 49% 48%,rgba(0,229,255,.14),transparent 19%),radial-gradient(ellipse at 15% 80%,rgba(0,255,163,.055),transparent 28%),radial-gradient(ellipse at 84% 24%,rgba(124,77,255,.13),transparent 36%);filter:blur(10px);opacity:.8}
.gv-grid{opacity:.1;background-image:linear-gradient(rgba(155,225,232,.3) 1px,transparent 1px),linear-gradient(90deg,rgba(155,225,232,.3) 1px,transparent 1px);background-size:78px 78px;transform:perspective(700px) rotateX(68deg) scale(1.7);transform-origin:50% 82%;mask-image:linear-gradient(transparent,#000 25%,#000 72%,transparent)}
.gv-vignette{background:radial-gradient(ellipse at center,transparent 34%,rgba(0,0,0,.58) 100%)}
.gv-scanlines{opacity:.055;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.5) 4px,transparent 5px);mix-blend-mode:screen}
.gv-origin{position:absolute;left:3.5vw;top:9vh;width:clamp(80px,8vw,135px);aspect-ratio:1;border-radius:50%;opacity:.75}
.gv-origin__planet{position:absolute;inset:22%;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(225,255,255,.75),rgba(0,229,255,.18) 28%,rgba(8,15,29,.98) 70%);box-shadow:0 0 42px rgba(0,229,255,.16)}
.gv-origin__planet:after{content:"";position:absolute;inset:-18%;border:1px solid rgba(0,229,255,.16);border-radius:50%;transform:rotate(-18deg) scaleX(1.7)}
.gv-origin__label{position:absolute;top:112%;left:50%;transform:translateX(-50%);white-space:nowrap;font:600 .42rem var(--font-code);letter-spacing:.14em;color:rgba(220,245,249,.28)}
.gv-hud{position:absolute;z-index:30;display:grid;gap:.35rem;font:600 .52rem/1.2 var(--font-code);letter-spacing:.15em;text-transform:uppercase;color:rgba(220,245,249,.32)}
.gv-hud b{color:rgba(220,245,249,.74)}.gv-hud span{font-size:.42rem;color:rgba(220,245,249,.22)}
.gv-hud--tl{left:4vw;top:4vh}.gv-hud--tr{right:4vw;top:4vh;text-align:right}.gv-hud--bl{left:4vw;bottom:4vh}
.gv-title{position:absolute;z-index:31;left:8vw;top:50%;transform:translateY(-50%);display:grid;gap:.55rem;opacity:.92;pointer-events:none;text-shadow:0 0 50px rgba(0,229,255,.08)}
.gv-title span{color:rgba(220,245,249,.4);font:600 .55rem var(--font-code);letter-spacing:.2em}
.gv-title strong,.gv-title b{display:block;font:700 clamp(3rem,7.7vw,8.2rem)/.8 var(--font-display);letter-spacing:-.08em;text-transform:uppercase}
.gv-title strong{color:#eefcff}.gv-title b{color:#bffaff}
.gv-progress{position:absolute;z-index:35;left:8vw;right:8vw;bottom:13vh}
.gv-progress__meta{display:flex;justify-content:space-between;margin-bottom:.65rem;color:rgba(220,245,249,.42);font:600 .5rem var(--font-code);letter-spacing:.18em}
.gv-progress__meta b{color:#bffaff}
.gv-progress__track{height:2px;background:rgba(220,245,249,.12);overflow:hidden;box-shadow:0 0 18px rgba(0,229,255,.08)}
.gv-progress__track i{display:block;width:0;height:100%;background:linear-gradient(90deg,rgba(0,229,255,.3),#bffaff,rgba(124,77,255,.75));box-shadow:0 0 18px rgba(0,229,255,.65);transform-origin:left center}
.gv-progress__ticks{display:flex;justify-content:space-between;margin-top:.35rem;color:rgba(220,245,249,.18);font:600 .38rem var(--font-code);letter-spacing:.1em}
.gv-ship{position:absolute;z-index:40;left:50%;top:50%;width:min(29vw,390px);height:min(17vw,220px);transform:translate(-50%,-50%) translate(-46vw,-31vh) scale(.035) rotate(-18deg);transform-origin:center;opacity:1;filter:drop-shadow(0 0 24px rgba(0,229,255,.18));will-change:transform}
.gv-ship__body{position:absolute;inset:20% 10%;transform:perspective(500px) rotateX(8deg);border:1px solid rgba(214,249,255,.5);border-radius:48% 18% 44% 22%/44% 28% 48% 32%;background:linear-gradient(135deg,rgba(228,250,255,.28),rgba(12,22,36,.98) 38%,rgba(2,8,15,.98));box-shadow:inset 0 0 24px rgba(0,229,255,.12),0 0 34px rgba(0,229,255,.13)}
.gv-ship__nose{position:absolute;left:4%;top:38%;width:17%;height:25%;border-radius:70% 30% 30% 70%;background:rgba(218,252,255,.6);filter:blur(.3px)}
.gv-ship__cockpit{position:absolute;left:30%;top:14%;width:37%;height:34%;border:1px solid rgba(140,236,255,.55);border-radius:55% 55% 30% 30%;background:linear-gradient(135deg,rgba(167,245,255,.25),rgba(4,16,29,.92));box-shadow:inset 0 0 18px rgba(0,229,255,.2)}
.gv-ship__wing{position:absolute;top:53%;width:34%;height:22%;background:linear-gradient(135deg,rgba(19,48,66,.95),rgba(4,10,18,.98));border:1px solid rgba(0,229,255,.28)}
.gv-ship__wing--l{left:-13%;transform:skewY(18deg) rotate(-9deg);clip-path:polygon(0 70%,100% 0,80% 100%,18% 100%)}
.gv-ship__wing--r{right:-13%;transform:skewY(-18deg) rotate(9deg);clip-path:polygon(0 0,100% 70%,82% 100%,20% 100%)}
.gv-ship__engine{position:absolute;bottom:5%;width:9%;height:21%;border-radius:50%;background:linear-gradient(#f7ffff,#00e5ff 30%,#7c4dff 72%,transparent);box-shadow:0 0 18px rgba(0,229,255,.55)}
.gv-ship__engine--l{left:25%}.gv-ship__engine--r{right:25%}
.gv-ship__trail{position:absolute;left:-3%;top:43%;width:48%;height:14%;background:linear-gradient(90deg,transparent,rgba(0,229,255,.16),rgba(226,255,255,.72));filter:blur(7px);transform-origin:right center}
.gv-ship__glow{position:absolute;inset:15%;border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,.13),transparent 64%);filter:blur(15px);z-index:-1}
.gv-ship__door{position:absolute;left:43%;top:49%;width:19%;height:38%;border:1px solid rgba(206,250,255,.65);border-radius:8px 8px 18px 18px;background:linear-gradient(180deg,rgba(214,250,255,.12),rgba(0,229,255,.03));transform-origin:50% 100%;display:grid;place-items:center;overflow:hidden}
.gv-ship__door i{width:35%;height:1px;background:rgba(0,229,255,.8);box-shadow:0 0 10px rgba(0,229,255,.8)}
.gv-ship__door b{font:600 .32rem var(--font-code);letter-spacing:.12em;color:rgba(220,245,249,.45);writing-mode:vertical-rl}
.gv-arrival-core{position:absolute;z-index:39;left:50%;top:50%;width:min(46vw,650px);aspect-ratio:1;transform:translate(-50%,-50%) scale(.2);opacity:0;pointer-events:none}
.gv-arrival-core__ring{position:absolute;inset:9%;border:1px solid rgba(0,229,255,.24);border-radius:50%;transform:rotateX(68deg)}
.gv-arrival-core__ring--b{inset:22%;border-color:rgba(124,77,255,.25);transform:rotateY(67deg) rotateZ(25deg)}
.gv-arrival-core__cross{position:absolute;inset:49.8% 4%;height:1px;background:rgba(0,229,255,.35);box-shadow:0 0 18px rgba(0,229,255,.2)}
.gv-arrival-core__cross:after{content:"";position:absolute;left:50%;top:-230px;width:1px;height:460px;background:rgba(0,229,255,.2)}
.gv-arrival-core__energy{position:absolute;inset:44%;border-radius:50%;background:radial-gradient(circle,#f7ffff 0 8%,#00e5ff 16%,rgba(0,229,255,.2) 45%,transparent 72%);box-shadow:0 0 60px rgba(0,229,255,.55)}
.gv-arrival-core__label{position:absolute;left:50%;top:76%;transform:translateX(-50%);white-space:nowrap;color:rgba(221,249,252,.42);font:600 .46rem var(--font-code);letter-spacing:.16em}
.gv-cloud{position:absolute;z-index:70;inset:-20%;opacity:0;pointer-events:none;filter:blur(32px)}
.gv-cloud span{position:absolute;border-radius:50%;background:rgba(255,255,255,.86);mix-blend-mode:screen}
.gv-cloud span:nth-child(1){width:45vw;height:45vw;left:16%;top:22%}
.gv-cloud span:nth-child(2){width:38vw;height:38vw;right:10%;top:8%}
.gv-cloud span:nth-child(3){width:52vw;height:42vw;left:30%;bottom:2%}
.gv-cloud span:nth-child(4){width:34vw;height:34vw;left:-2%;bottom:12%}
.gv-cloud span:nth-child(5){width:32vw;height:32vw;right:-2%;bottom:20%}
.gv-whiteout{position:absolute;z-index:80;inset:-4%;background:#fff;opacity:0;pointer-events:none}
.gv-skip{position:absolute;z-index:100;right:4vw;bottom:4vh;border:0;background:none;color:rgba(236,255,255,.34);font:600 .48rem var(--font-code);letter-spacing:.15em;cursor:pointer}
.gv-skip kbd{margin-left:.45rem;color:rgba(0,229,255,.72);font:inherit}

/* Loading choreography: 0 -> 100 happens before the white transition. */
.gv-intro .gv-progress__track i{animation:gv-progress 8.05s linear forwards}
.gv-intro.phase-approach .gv-ship{animation:gv-ship-arrival 3.45s cubic-bezier(.12,.76,.18,1) forwards}
.gv-intro.phase-door .gv-ship__door{animation:gv-door-open .8s cubic-bezier(.16,1,.3,1) forwards}
.gv-intro.phase-door .gv-arrival-core{opacity:.42;transform:translate(-50%,-50%) scale(.75);transition:opacity .7s ease,transform 1.1s cubic-bezier(.16,1,.3,1)}
.gv-intro.phase-bot .gv-arrival-core{opacity:.88;transform:translate(-50%,-50%) scale(1);animation:gv-core-spin 4s linear infinite}
.gv-intro.phase-bot .gv-ship{filter:drop-shadow(0 0 45px rgba(0,229,255,.28))}
.gv-intro.phase-white .gv-cloud{animation:gv-cloud-bloom 1.65s cubic-bezier(.2,.78,.18,1) forwards}
.gv-intro.phase-white .gv-whiteout{animation:gv-whiteout 1.75s cubic-bezier(.55,0,.2,1) forwards}
.gv-intro.phase-white .gv-title,.gv-intro.phase-white .gv-hud,.gv-intro.phase-white .gv-progress,.gv-intro.phase-white .gv-origin{opacity:0;transition:opacity .35s ease}
.gv-intro.phase-reveal .gv-cloud{animation:gv-cloud-recede 1.1s cubic-bezier(.55,.05,.2,1) forwards}
.gv-intro.phase-reveal .gv-whiteout{opacity:0;transition:opacity 1.1s ease}
.gv-intro.phase-reveal .gv-ship{opacity:0;transition:opacity .7s ease}
.gv-intro.phase-reveal .gv-arrival-core{opacity:0;transition:opacity .6s ease}
.gv-intro.phase-reveal .gv-skip{opacity:0;pointer-events:none}
.gv-intro.phase-reveal{background:transparent;transition:background .8s ease}
@keyframes gv-progress{0%{width:0}28%{width:22%}45%{width:46%}63%{width:68%}82%{width:86%}100%{width:100%}}
@keyframes gv-ship-arrival{
  0%{transform:translate(-50%,-50%) translate(-47vw,-31vh) scale(.035) rotate(-18deg)}
  22%{transform:translate(-50%,-50%) translate(-31vw,-21vh) scale(.12) rotate(-12deg)}
  48%{transform:translate(-50%,-50%) translate(-15vw,-10vh) scale(.34) rotate(-7deg)}
  73%{transform:translate(-50%,-50%) translate(-5vw,-3vh) scale(.78) rotate(-3deg)}
  90%{transform:translate(-50%,-50%) translate(0,0) scale(1.1) rotate(0deg)}
  100%{transform:translate(-50%,-50%) translate(0,0) scale(1) rotate(0deg)}
}
@keyframes gv-door-open{0%{transform:scaleY(1);opacity:1}100%{transform:scaleY(.12) translateY(8%);opacity:.22}}
@keyframes gv-core-spin{to{transform:translate(-50%,-50%) scale(1) rotate(360deg)}}
@keyframes gv-cloud-bloom{0%{opacity:0;transform:scale(.5)}25%{opacity:.35}65%{opacity:.8;transform:scale(1.05)}100%{opacity:1;transform:scale(1.3)}}
@keyframes gv-cloud-recede{0%{opacity:1;transform:scale(1.3)}100%{opacity:0;transform:scale(1.65)}}
@keyframes gv-whiteout{0%{opacity:0}38%{opacity:.86}62%{opacity:.98}100%{opacity:.05}}
@keyframes gv-stars-far{to{background-position:137px 137px}}
@keyframes gv-stars-near{to{background-position:-130px 125px}}
@media(max-width:700px){
  .gv-title{left:1rem}.gv-title strong,.gv-title b{font-size:clamp(2.7rem,13vw,5rem)}
  .gv-hud--tr,.gv-hud--bl,.gv-origin{display:none}
  .gv-progress{left:1rem;right:1rem;bottom:11vh}
  .gv-ship{width:68vw;height:40vw}
  .gv-arrival-core{width:92vw}
  .gv-skip{right:1rem;bottom:1.4rem}
}
@media(prefers-reduced-motion:reduce){
  .gv-stars,.gv-progress__track i,.gv-arrival-core__ring,.gv-arrival-core,.gv-ship{animation:none!important}
  .gv-progress__track i{width:100%}
}


/* Keep the real GURU-BOT visually behind the atmospheric whiteout.
   It returns above the interface only after the website reveal event. */
html.guruverse-whiteout .guru-bot--booting{
  z-index:calc(var(--z-loader) - 1)!important;
}

/* ==========================================================
   REFERENCE-ACCURATE SPACECRAFT CINEMATOGRAPHY
   A larger, layered vehicle silhouette is used so the arrival
   reads as a physical craft rather than a UI icon.
   ========================================================== */
.gv-ship{
  perspective:1100px;
}
.gv-ship__body{
  transform:perspective(900px) rotateX(13deg) rotateY(-4deg) translateZ(0);
  clip-path:polygon(3% 48%,11% 31%,29% 18%,43% 7%,58% 9%,75% 20%,90% 35%,98% 51%,89% 69%,73% 78%,57% 92%,40% 88%,25% 77%,10% 66%);
  border-radius:0;
  background:
    radial-gradient(ellipse at 51% 73%,rgba(255,255,255,.22),transparent 9%),
    linear-gradient(155deg,rgba(247,253,255,.82) 0%,rgba(93,126,143,.55) 22%,rgba(13,25,38,.98) 48%,rgba(2,7,13,.99) 82%);
  border:1px solid rgba(224,249,255,.58);
  box-shadow:
    inset 0 -24px 35px rgba(0,0,0,.55),
    inset 0 7px 22px rgba(255,255,255,.15),
    0 20px 45px rgba(0,0,0,.45),
    0 0 45px rgba(0,229,255,.18);
}
.gv-ship__body:before{
  content:"";
  position:absolute;
  left:24%;right:24%;top:13%;height:20%;
  border:1px solid rgba(191,250,255,.4);
  border-radius:50% 50% 35% 35%;
  background:linear-gradient(180deg,rgba(2,10,19,.45),rgba(0,229,255,.12));
  box-shadow:inset 0 0 18px rgba(0,229,255,.22);
}
.gv-ship__body:after{
  content:"";
  position:absolute;
  left:38%;right:38%;bottom:3%;height:26%;
  border:1px solid rgba(0,229,255,.35);
  border-radius:10px 10px 40% 40%;
  background:
    radial-gradient(circle at 50% 35%,rgba(247,255,255,.9) 0 4%,rgba(0,229,255,.72) 8%,transparent 18%),
    linear-gradient(180deg,rgba(20,39,53,.85),rgba(1,7,13,.98));
  box-shadow:0 0 30px rgba(0,229,255,.2),inset 0 0 18px rgba(0,229,255,.16);
}
.gv-ship__cockpit{
  left:35%;top:11%;width:30%;height:27%;
  border-radius:52% 52% 28% 28%;
  background:
    linear-gradient(155deg,rgba(212,250,255,.22),rgba(3,13,24,.95) 58%),
    radial-gradient(ellipse at 50% 20%,rgba(0,229,255,.18),transparent 60%);
  box-shadow:inset 0 0 20px rgba(0,229,255,.24),0 0 14px rgba(0,229,255,.12);
}
.gv-ship__cockpit:after{
  content:"";
  position:absolute;left:18%;right:18%;top:35%;height:1px;
  background:rgba(191,250,255,.42);
  box-shadow:0 9px rgba(191,250,255,.12),0 -9px rgba(191,250,255,.12);
}
.gv-ship__wing{
  top:51%;height:29%;
  background:linear-gradient(145deg,rgba(109,145,161,.58),rgba(5,15,25,.98) 58%);
  box-shadow:inset 0 0 18px rgba(0,229,255,.08);
}
.gv-ship__engine{
  bottom:4%;height:25%;
  background:radial-gradient(ellipse at 50% 15%,#fff 0 5%,#00e5ff 15%,#7c4dff 40%,rgba(0,229,255,.12) 62%,transparent 76%);
  filter:blur(.15px);
  box-shadow:0 0 22px rgba(0,229,255,.7),0 0 45px rgba(124,77,255,.3);
}
.gv-ship__trail{
  left:-19%;top:45%;width:64%;height:18%;
  background:linear-gradient(90deg,transparent 0%,rgba(124,77,255,.12) 24%,rgba(0,229,255,.42) 68%,rgba(237,255,255,.9) 100%);
  filter:blur(8px);
  opacity:.9;
}
.gv-ship__door{
  left:38%;top:66%;width:24%;height:31%;
  border-color:rgba(226,251,255,.8);
  border-radius:12px 12px 22px 22px;
  background:
    linear-gradient(180deg,rgba(255,255,255,.12),rgba(0,229,255,.1) 32%,rgba(2,8,14,.95) 72%);
  box-shadow:inset 0 0 24px rgba(0,229,255,.2),0 0 22px rgba(0,229,255,.14);
}
.gv-ship__door:before{
  content:"";
  position:absolute;inset:9% 13% 30%;
  border:1px solid rgba(0,229,255,.26);
  border-radius:7px;
  background:radial-gradient(circle at 50% 90%,rgba(247,255,255,.9),rgba(0,229,255,.35) 12%,transparent 52%);
  box-shadow:inset 0 0 20px rgba(0,229,255,.28);
}
.gv-ship__door i{
  position:absolute;left:34%;bottom:13%;width:32%;height:2px;
  background:#efffff;
  box-shadow:0 0 15px #00e5ff,0 0 30px rgba(0,229,255,.7);
}
.gv-intro.phase-door .gv-ship__door{
  animation:gv-door-open .9s cubic-bezier(.16,1,.3,1) forwards;
}
.gv-intro.phase-bot .gv-ship{
  animation:gv-ship-hover 3.2s ease-in-out infinite;
}
@keyframes gv-ship-hover{
  0%,100%{margin-top:0}
  50%{margin-top:-5px}
}
@media(max-width:700px){
  .gv-ship{width:78vw;height:48vw}
}

</style>

<script is:inline>
(function(){
  const intro=document.querySelector("[data-cinematic-intro]");
  if(!intro)return;
  const status=intro.querySelector("[data-intro-status]");
  const stage=intro.querySelector("[data-intro-stage]");
  const code=intro.querySelector("[data-intro-code]");
  const value=intro.querySelector("[data-progress-value]");
  const bar=intro.querySelector("[data-progress-bar]");
  const skip=intro.querySelector("[data-intro-skip]");
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timers=[];
  let done=false;

  document.documentElement.classList.add("guruverse-booting");

  const later=(fn,ms)=>timers.push(window.setTimeout(fn,ms));
  const emit=(name)=>window.dispatchEvent(new CustomEvent(name));

  function setState(className,label,codeText,percent){
    intro.classList.remove("phase-approach","phase-door","phase-bot","phase-white","phase-reveal");
    intro.classList.add(className);
    if(status)status.textContent=label;
    if(stage)stage.textContent=className.replace("phase-","").toUpperCase();
    if(code)code.textContent=codeText;
    if(value)value.textContent=`${percent}%`;
    if(bar && !reduce)bar.style.width=`${percent}%`;
  }

  function finish(){
    if(done)return;
    done=true;
    timers.forEach(clearTimeout);
    document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");
    intro.classList.add("is-complete");
    later(()=>emit("guruverse:intro-complete"),120);
    later(()=>intro.remove(),850);
  }

  function run(){
    if(reduce){
      setState("phase-reveal","UNIVERSE ONLINE","READY / REDUCED MOTION",100);
      document.documentElement.classList.remove("guruverse-booting");
      emit("guruverse:website-revealed");
      later(finish,500);
      return;
    }

    setState("phase-approach","VESSEL APPROACHING FROM FAR ORBIT","01 / ARRIVAL",0);
    emit("guruverse:boot-start");

    later(()=>{
      setState("phase-door","VESSEL STABILIZED / HATCH OPENING","02 / IDENTITY BAY",34);
      emit("guruverse:ship-door-open");
    },3450);

    later(()=>{
      setState("phase-bot","GURU-BOT DEPLOYED / HOLDING","03 / CORE TRANSFER",58);
      emit("guruverse:bot-emerge");
    },4300);

    later(()=>{
      setState("phase-bot","GURU-BOT HOLDING / FINALISING LOAD","04 / 78%",78);
    },6100);

    later(()=>{
      setState("phase-bot","LOAD COMPLETE / 100 PERCENT","05 / 100%",100);
    },7600);

    later(()=>{
      setState("phase-white","ATMOSPHERIC TRANSITION","06 / WHITEOUT",100);
      document.documentElement.classList.add("guruverse-whiteout");
      emit("guruverse:boot-whiteout");
    },8050);

    later(()=>{
      setState("phase-reveal","GURUVERSE ONLINE / WEBSITE REVEALED","07 / REVEALED",100);
      document.documentElement.classList.remove("guruverse-whiteout","guruverse-booting");
      emit("guruverse:website-reveal-start");
      emit("guruverse:website-revealed");
    },8850);

    later(finish,9650);
  }

  function skipSequence(){
    if(done)return;
    timers.forEach(clearTimeout);
    setState("phase-reveal","GURUVERSE ONLINE / WEBSITE REVEALED","SKIPPED / READY",100);
    document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");
    emit("guruverse:website-revealed");
    later(finish,300);
  }

  skip?.addEventListener("click",skipSequence);
  window.addEventListener("keydown",(event)=>{if(event.key==="Escape")skipSequence()},{once:true});
  requestAnimationFrame(run);
})();
</script>
