---
---
<div class="gv-loader" data-cinematic-intro aria-label="GURUVERSE cinematic boot sequence">
  <canvas class="gv-loader__canvas" data-loader-canvas aria-hidden="true"></canvas>
  <div class="gv-loader__veil"></div>
  <div class="gv-loader__hud gv-loader__hud--tl"><strong>GURUVERSE / SYS-01</strong><span>ENGINEERING UNIVERSE INITIALISATION</span></div>
  <div class="gv-loader__hud gv-loader__hud--tr"><strong data-stage>ARRIVAL</strong><span data-code>00 / 000%</span></div>
  <div class="gv-loader__copy"><small>GURUVERSE // IDENTITY ARRIVAL PROTOCOL</small><strong>INITIALISING</strong><b>IDENTITY SYSTEM</b></div>
  <div class="gv-loader__status"><strong data-status>ESTABLISHING LONG-RANGE LINK</strong><span>VESSEL · IDENTITY CORE · GURU-BOT</span></div>
  <div class="gv-loader__progress">
    <div><span>BOOT SEQUENCE</span><strong data-value>0%</strong></div>
    <i><b data-bar></b></i>
    <small><span>00</span><span>25</span><span>50</span><span>75</span><span>100</span></small>
  </div>
  <button class="gv-loader__skip" type="button" data-intro-skip>SKIP <kbd>ESC</kbd></button>
</div>

<style is:inline>
.gv-loader{position:fixed;inset:0;z-index:var(--z-loader);overflow:hidden;background:#02050a;color:#f0fdff;isolation:isolate;opacity:1;visibility:visible;pointer-events:auto}
.gv-loader.is-complete{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .8s ease,visibility 0s linear .8s}
.gv-loader__canvas,.gv-loader__veil{position:absolute;inset:0;width:100%;height:100%}
.gv-loader__canvas{display:block}
.gv-loader__veil{background:radial-gradient(ellipse at 50% 50%,transparent 25%,rgba(0,0,0,.18) 56%,rgba(0,0,0,.78) 100%),linear-gradient(180deg,rgba(0,0,0,.18),transparent 35%,rgba(0,0,0,.3));pointer-events:none}
.gv-loader__hud{position:absolute;z-index:5;display:grid;gap:.3rem;font:600 .52rem/1.2 var(--font-code);letter-spacing:.16em;color:rgba(220,246,250,.36);text-transform:uppercase}
.gv-loader__hud strong{color:rgba(220,246,250,.8)}.gv-loader__hud span{font-size:.42rem;color:rgba(220,246,250,.22)}
.gv-loader__hud--tl{left:4vw;top:4vh}.gv-loader__hud--tr{right:4vw;top:4vh;text-align:right}
.gv-loader__copy{position:absolute;z-index:5;left:8vw;top:50%;transform:translateY(-50%);display:grid;gap:.5rem;pointer-events:none;text-shadow:0 0 40px rgba(0,229,255,.08)}
.gv-loader__copy small{font:600 .52rem var(--font-code);letter-spacing:.2em;color:rgba(220,246,250,.4)}
.gv-loader__copy strong,.gv-loader__copy b{font:700 clamp(3rem,7.6vw,8rem)/.8 var(--font-display);letter-spacing:-.08em}
.gv-loader__copy strong{color:#f0fdff}.gv-loader__copy b{color:#b9f8ff}
.gv-loader__status{position:absolute;z-index:5;left:4vw;bottom:4vh;display:grid;gap:.35rem;font:600 .5rem var(--font-code);letter-spacing:.14em;color:rgba(220,246,250,.32);text-transform:uppercase}
.gv-loader__status strong{color:rgba(220,246,250,.75)}
.gv-loader__status span{font-size:.4rem;color:rgba(220,246,250,.2)}
.gv-loader__progress{position:absolute;z-index:5;left:8vw;right:8vw;bottom:12vh}
.gv-loader__progress>div{display:flex;justify-content:space-between;margin-bottom:.6rem;font:600 .48rem var(--font-code);letter-spacing:.18em;color:rgba(220,246,250,.4)}
.gv-loader__progress strong{color:#c8fbff}
.gv-loader__progress>i{display:block;height:2px;background:rgba(220,246,250,.13);overflow:hidden;box-shadow:0 0 20px rgba(0,229,255,.08)}
.gv-loader__progress>i b{display:block;width:0;height:100%;background:linear-gradient(90deg,#00bcd4,#e9ffff,#7c4dff);box-shadow:0 0 18px rgba(0,229,255,.7);transform-origin:left}
.gv-loader__progress small{display:flex;justify-content:space-between;margin-top:.35rem;font:600 .38rem var(--font-code);letter-spacing:.1em;color:rgba(220,246,250,.18)}
.gv-loader__skip{position:absolute;z-index:8;right:4vw;bottom:4vh;border:0;background:none;color:rgba(236,255,255,.35);font:600 .48rem var(--font-code);letter-spacing:.15em;cursor:pointer}
.gv-loader__skip kbd{margin-left:.4rem;color:#6befff;font:inherit}
.gv-loader.phase-white .gv-loader__copy,.gv-loader.phase-white .gv-loader__hud,.gv-loader.phase-white .gv-loader__status,.gv-loader.phase-white .gv-loader__progress{opacity:0;transition:opacity .3s ease}
@media(max-width:700px){.gv-loader__copy{left:1rem}.gv-loader__copy strong,.gv-loader__copy b{font-size:clamp(2.7rem,13vw,5rem)}.gv-loader__hud--tr,.gv-loader__status{display:none}.gv-loader__progress{left:1rem;right:1rem;bottom:11vh}.gv-loader__skip{right:1rem;bottom:1.4rem}}
</style>

<script is:inline>
(function(){
  const root=document.querySelector("[data-cinematic-intro]");
  const canvas=root?.querySelector("[data-loader-canvas]");
  if(!root||!canvas)return;
  const ctx=canvas.getContext("2d",{alpha:false});
  const status=root.querySelector("[data-status]"),stage=root.querySelector("[data-stage]"),code=root.querySelector("[data-code]");
  const value=root.querySelector("[data-value]"),bar=root.querySelector("[data-bar]"),skip=root.querySelector("[data-intro-skip]");
  const reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  let W=innerWidth,H=innerHeight,D=devicePixelRatio||1,start=performance.now(),done=false,raf=0;
  const stars=Array.from({length:180},()=>({x:Math.random(),y:Math.random(),z:.2+Math.random()*.8,s:Math.random()*1.8+.25}));
  const dust=Array.from({length:42},()=>({a:Math.random()*Math.PI*2,r:80+Math.random()*420,s:.3+Math.random()*.9}));
  function resize(){W=innerWidth;H=innerHeight;D=Math.min(devicePixelRatio||1,2);canvas.width=W*D;canvas.height=H*D;ctx.setTransform(D,0,0,D,0,0)}
  addEventListener("resize",resize);resize();
  const later=(f,t)=>setTimeout(f,t);
  function emit(n){dispatchEvent(new CustomEvent(n))}
  function state(cls,s,c,p){root.className="gv-loader "+cls;status.textContent=s;stage.textContent=cls.replace("phase-","").toUpperCase();code.textContent=c;value.textContent=p+"%";bar.style.width=p+"%"}
  function ease(t){return 1-Math.pow(1-t,3)}
  function roundRect(x,y,w,h,r){ctx.beginPath();ctx.roundRect(x,y,w,h,r)}
  function ship(t){
    const q=ease(Math.min(1,t/3450)), x=W*.5+(W*.5)*(1-q), y=H*.5+(H*.32)*(1-q), scale=.035+q*.98;
    ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);
    ctx.shadowBlur=35;ctx.shadowColor="rgba(0,229,255,.35)";
    const g=ctx.createLinearGradient(-180,-40,180,80);g.addColorStop(0,"#dff7ff");g.addColorStop(.28,"#6f8e9d");g.addColorStop(.55,"#132635");g.addColorStop(1,"#02070d");
    ctx.fillStyle=g;ctx.strokeStyle="rgba(220,250,255,.7)";ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(-205,5);ctx.lineTo(-135,-48);ctx.lineTo(-50,-75);ctx.lineTo(15,-65);ctx.lineTo(110,-35);ctx.lineTo(205,5);ctx.lineTo(130,42);ctx.lineTo(42,62);ctx.lineTo(-50,58);ctx.lineTo(-145,40);ctx.closePath();ctx.fill();ctx.stroke();
    ctx.shadowBlur=0;
    ctx.fillStyle="rgba(2,10,19,.9)";roundRect(-58,-56,116,46,23);ctx.fill();ctx.strokeStyle="rgba(102,231,255,.5)";ctx.stroke();
    ctx.fillStyle="#eaffff";ctx.shadowBlur=20;ctx.shadowColor="#00e5ff";ctx.beginPath();ctx.ellipse(-122,3,17,8,0,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(122,3,17,8,0,0,Math.PI*2);ctx.fill();
    ctx.shadowBlur=0;ctx.fillStyle="rgba(0,229,255,.35)";ctx.fillRect(-150,35,65,12);ctx.fillRect(85,35,65,12);
    const door=Math.max(0,Math.min(1,(t-3450)/850));ctx.fillStyle="rgba(2,8,14,.96)";ctx.strokeStyle="rgba(206,250,255,.75)";
    const dy=38+door*55;ctx.beginPath();ctx.moveTo(-47,35);ctx.lineTo(47,35);ctx.lineTo(54,dy);ctx.lineTo(-54,dy);ctx.closePath();ctx.fill();ctx.stroke();
    ctx.fillStyle="rgba(0,229,255,.7)";ctx.fillRect(-30,43,60,2);
    ctx.restore();
  }
  function core(t){
    const a=t*.0005,r=Math.min(W,H)*.19;
    ctx.save();ctx.translate(W/2,H/2);ctx.globalAlpha=Math.min(1,Math.max(0,(t-3500)/900));
    for(let i=0;i<3;i++){ctx.save();ctx.rotate(a*(i%2?-.7:.5));ctx.strokeStyle=i===1?"rgba(124,77,255,.45)":"rgba(0,229,255,.4)";ctx.lineWidth=1;ctx.setLineDash([10+i*7,18+i*9]);ctx.beginPath();ctx.ellipse(0,0,r*(1+i*.22),r*(.28+i*.08),i*.6,0,Math.PI*2);ctx.stroke();ctx.restore()}
    const g=ctx.createRadialGradient(0,0,0,0,0,r*.42);g.addColorStop(0,"#fff");g.addColorStop(.06,"#00e5ff");g.addColorStop(.32,"rgba(0,229,255,.22)");g.addColorStop(1,"transparent");ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,r*.42,0,Math.PI*2);ctx.fill();ctx.restore()
  }
  function cloud(t){
    const q=Math.min(1,Math.max(0,(t-8050)/1100)), a=q<.5?q*1.8:(1-q)*1.8;
    if(a<=0)return;ctx.save();ctx.globalAlpha=Math.min(1,a);
    const g=ctx.createRadialGradient(W*.5,H*.5,0,W*.5,H*.5,Math.max(W,H)*.72);g.addColorStop(0,"rgba(255,255,255,.98)");g.addColorStop(.3,"rgba(255,255,255,.9)");g.addColorStop(.72,"rgba(255,255,255,.48)");g.addColorStop(1,"rgba(255,255,255,0)");
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    for(let i=0;i<18;i++){const x=W*(.12+((i*47)%80)/100),y=H*(.15+((i*71)%70)/100),s=90+((i*31)%170);ctx.fillStyle="rgba(255,255,255,.12)";ctx.beginPath();ctx.arc(x,y,s,0,Math.PI*2);ctx.fill()}
    ctx.restore()
  }
  function scene(now){
    const t=now-start;
    const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,"#01040a");bg.addColorStop(.5,"#03101a");bg.addColorStop(1,"#010205");ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
    stars.forEach(s=>{let x=(s.x*W + t*.006*s.z)%W,y=s.y*H;ctx.globalAlpha=.18+.5*s.z;ctx.fillStyle=s.z>.7?"#bffaff":"#8ca6b2";ctx.fillRect(x,y,s.s,s.s)});
    ctx.globalAlpha=.1;ctx.strokeStyle="#55dfff";ctx.lineWidth=1;for(let i=0;i<12;i++){ctx.beginPath();ctx.moveTo(W*.5,H*.56);ctx.lineTo(i*W/11, H);ctx.stroke()}ctx.globalAlpha=1;
    if(t<5700)ship(t);core(t);
    if(t>=8050)cloud(t);
    const p=Math.min(100,Math.round(t<7600?t/76:t<8050?100:100));value.textContent=p+"%";bar.style.width=p+"%";
    if(!done){raf=requestAnimationFrame(scene)}
  }
  function finish(){if(done)return;done=true;cancelAnimationFrame(raf);root.classList.add("is-complete");document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");later(()=>emit("guruverse:intro-complete"),120);later(()=>root.remove(),900)}
  function run(){
    document.documentElement.classList.add("guruverse-booting");
    if(reduce){state("phase-reveal","GURUVERSE ONLINE","READY / REDUCED MOTION",100);emit("guruverse:website-revealed");later(finish,500);return}
    state("phase-approach","VESSEL APPROACHING FROM FAR ORBIT","01 / ARRIVAL",0);emit("guruverse:boot-start");
    start=performance.now();raf=requestAnimationFrame(scene);
    later(()=>{state("phase-door","VESSEL STABILIZED / IDENTITY BAY OPENING","02 / IDENTITY BAY",34);emit("guruverse:ship-door-open")},3450);
    later(()=>{state("phase-bot","GURU-BOT DEPLOYED / HOLDING","03 / INTELLIGENCE CORE",58);emit("guruverse:bot-emerge")},4300);
    later(()=>{state("phase-bot","GURU-BOT HOLDING / FINALISING LOAD","04 / 78%",78)},6100);
    later(()=>{state("phase-bot","LOAD COMPLETE / 100 PERCENT","05 / 100%",100)},7600);
    later(()=>{state("phase-white","ATMOSPHERIC TRANSITION","06 / WHITE CLOUD",100);document.documentElement.classList.add("guruverse-whiteout");emit("guruverse:boot-whiteout")},8050);
    later(()=>{state("phase-reveal","GURUVERSE ONLINE / WEBSITE REVEALED","07 / REVEALED",100);document.documentElement.classList.remove("guruverse-whiteout","guruverse-booting");emit("guruverse:website-reveal-start");emit("guruverse:website-revealed");later(finish,180)},8850);
    /* The loader is removed immediately after reveal. The real GURU-BOT
       then travels across the now-visible website, rather than underneath it. */
  }
  skip?.addEventListener("click",()=>{cancelAnimationFrame(raf);document.documentElement.classList.remove("guruverse-booting","guruverse-whiteout");emit("guruverse:website-revealed");finish()});
  addEventListener("keydown",e=>{if(e.key==="Escape")skip?.click()},{once:true});
  run();
})();
</script>