<div class="gv-intro" data-cinematic-intro>
  <div class="gv-intro__field"></div><div class="gv-intro__grid"></div>
  <div class="gv-intro__stage">
    <div class="gv-intro__core"><span class="gv-intro__orbit gv-intro__orbit--outer"></span><span class="gv-intro__orbit gv-intro__orbit--inner"></span><span class="gv-intro__signal"></span></div>
    <div class="gv-intro__portrait">
      <div class="gv-intro__portrait-frame">
        <img src={import.meta.env.BASE_URL + "images/profile.jpeg"} alt="Guru Charan Mavuduru" width="640" height="800" fetchpriority="high" decoding="async" />
        <span class="gv-intro__portrait-scan"></span>
      </div>
      <div class="gv-intro__portrait-label"><span>IDENTITY / 001</span><strong>GURU CHARAN MAVUDURU</strong><small>AI · SECURITY · SOFTWARE · RESEARCH</small></div>
    </div>
  </div>
  <div class="gv-intro__readout"><span>GURUVERSE // BOOT SEQUENCE</span><strong data-intro-status>INITIALISING GURUVERSE</strong><span data-intro-progress>00 — 04</span></div>
  <div class="gv-intro__identity">GURU<span>CHARAN</span></div>
  <button class="gv-intro__skip" type="button" data-intro-skip>SKIP INTRO <span>ESC</span></button>
</div>
<style>
.gv-intro{position:fixed;inset:0;z-index:var(--z-loader);display:grid;place-items:center;overflow:hidden;background:#02040a;color:#f7fbff;isolation:isolate;opacity:1;transition:opacity .65s var(--ease-cinematic),visibility .65s}.gv-intro.is-complete{opacity:0;visibility:hidden;pointer-events:none}.gv-intro__field,.gv-intro__grid{position:absolute;inset:0;pointer-events:none}.gv-intro__field{background:radial-gradient(circle at 50% 50%,rgba(0,229,255,.12),transparent 22%),radial-gradient(circle at 25% 30%,rgba(124,77,255,.08),transparent 32%),#02040a}.gv-intro__grid{opacity:.28;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(circle at center,#000 0 30%,transparent 78%)}.gv-intro__stage{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:clamp(2rem,6vw,6rem);width:min(900px,90vw)}.gv-intro__core{position:relative;width:min(34vw,360px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;filter:drop-shadow(0 0 45px rgba(0,229,255,.2))}.gv-intro__core::before,.gv-intro__core::after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.16)}.gv-intro__core::before{inset:22%;box-shadow:0 0 80px rgba(0,229,255,.12),inset 0 0 60px rgba(124,77,255,.08)}.gv-intro__core::after{inset:39%;background:radial-gradient(circle,rgba(247,251,255,.9),rgba(0,229,255,.35) 28%,transparent 68%);border-color:rgba(0,229,255,.6);animation:gv-intro-pulse 1.4s ease-in-out infinite}.gv-intro__orbit{position:absolute;border:1px solid rgba(0,229,255,.28);border-radius:50%;transform:rotate(-22deg) rotateX(65deg);animation:gv-intro-spin 2.8s linear infinite}.gv-intro__orbit--outer{inset:-2%;border-color:rgba(124,77,255,.28)}.gv-intro__orbit--inner{inset:14%;transform:rotate(28deg) rotateX(68deg);animation-duration:2.1s;animation-direction:reverse}.gv-intro__signal{width:7px;height:7px;border-radius:50%;background:#dffcff;box-shadow:0 0 20px 5px rgba(0,229,255,.6)}.gv-intro__portrait{position:relative;width:min(24vw,270px);aspect-ratio:4/5;display:grid;place-items:center;opacity:0;transform:translateX(30px) scale(.96);animation:gv-intro-portrait-in .9s .35s var(--ease-cinematic) forwards}.gv-intro__portrait-frame{position:relative;width:100%;height:100%;overflow:hidden;clip-path:polygon(8% 0,92% 0,100% 8%,100% 92%,92% 100%,8% 100%,0 92%,0 8%);border:1px solid rgba(185,241,255,.28);background:#08111b;box-shadow:0 24px 80px rgba(0,0,0,.5),0 0 40px rgba(0,229,255,.08)}.gv-intro__portrait-frame::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(0,229,255,.12),transparent 40%,rgba(124,77,255,.08));mix-blend-mode:screen;pointer-events:none}.gv-intro__portrait-frame img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:saturate(.86) contrast(1.04)}.gv-intro__portrait-scan{position:absolute;left:0;right:0;top:0;height:1px;background:rgba(0,229,255,.9);box-shadow:0 0 14px rgba(0,229,255,.8);animation:gv-intro-portrait-scan 3s .8s ease-in-out infinite}.gv-intro__portrait-label{position:absolute;left:12%;right:-12%;bottom:5%;display:grid;gap:.25rem;padding:.6rem .7rem;border:1px solid rgba(255,255,255,.1);border-left-color:rgba(0,229,255,.5);background:rgba(2,5,11,.76);backdrop-filter:blur(10px)}.gv-intro__portrait-label span,.gv-intro__portrait-label small{font:600 .48rem/1.25 var(--font-code);letter-spacing:.1em;color:rgba(229,244,250,.45)}.gv-intro__portrait-label strong{font:700 .58rem/1.25 var(--font-code);letter-spacing:.05em;color:#eafcff}.gv-intro__readout{position:absolute;left:clamp(1rem,5vw,5rem);bottom:clamp(1rem,5vw,4rem);display:grid;gap:.35rem;font:500 .68rem/1.3 var(--font-code);letter-spacing:.16em;text-transform:uppercase;color:rgba(247,251,255,.58)}.gv-intro__readout strong{color:#dffcff;font-size:clamp(.78rem,1.2vw,1rem);letter-spacing:.11em}.gv-intro__identity{position:absolute;right:clamp(1rem,5vw,5rem);top:clamp(1rem,5vw,4rem);font:700 clamp(.8rem,1.2vw,1rem)/1 var(--font-display);letter-spacing:.2em}.gv-intro__identity span{display:block;color:rgba(0,229,255,.65);font-size:.62em;margin-top:.6em;letter-spacing:.35em}.gv-intro__skip{position:absolute;right:clamp(1rem,5vw,5rem);bottom:clamp(1rem,5vw,4rem);padding:.65rem .8rem;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:rgba(247,251,255,.65);font:600 .65rem/1 var(--font-code);letter-spacing:.12em;background:rgba(255,255,255,.025);cursor:pointer;transition:color .2s,border-color .2s,background .2s}.gv-intro__skip:hover,.gv-intro__skip:focus-visible{color:#fff;border-color:rgba(0,229,255,.5);background:rgba(0,229,255,.06)}.gv-intro__skip span{margin-left:.55rem;opacity:.5}@keyframes gv-intro-portrait-in{to{opacity:1;transform:none}}@keyframes gv-intro-portrait-scan{0%,100%{top:0;opacity:0}15%{opacity:.9}55%{top:100%;opacity:.8}70%{opacity:0}}@keyframes gv-intro-spin{to{transform:rotate(338deg) rotateX(65deg)}}@keyframes gv-intro-pulse{50%{transform:scale(1.18);opacity:.72}}@media(max-width:640px){.gv-intro__stage{flex-direction:column;gap:1rem;width:100%}.gv-intro__core{width:42vw;min-width:150px}.gv-intro__portrait{width:min(38vw,190px);min-width:150px;aspect-ratio:4/5;transform:translateY(16px) scale(.96)}.gv-intro__portrait-label{left:4%;right:-4%;bottom:2%}.gv-intro__portrait-label strong{font-size:.5rem}.gv-intro__readout{bottom:1rem;left:1rem}.gv-intro__skip{right:1rem;bottom:4.4rem}.gv-intro__identity{top:1rem;right:1rem}}@media(prefers-reduced-motion:reduce){.gv-intro{transition-duration:.1s}.gv-intro__orbit,.gv-intro__core::after,.gv-intro__portrait,.gv-intro__portrait-scan{animation:none}.gv-intro__portrait{opacity:1;transform:none}.gv-intro__core::after{opacity:.8}}
</style>
<script>
const intro=document.querySelector<HTMLElement>("[data-cinematic-intro]");
if(intro){const skip=intro.querySelector<HTMLButtonElement>("[data-intro-skip]"),status=intro.querySelector<HTMLElement>("[data-intro-status]"),progress=intro.querySelector<HTMLElement>("[data-intro-progress]"),reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches,seen=sessionStorage.getItem("guruverse-intro-seen")==="1";const stages=["INITIALISING GURUVERSE","IDENTITY SIGNAL DETECTED","ENGINEERING ARCHIVE CONNECTED","GURUVERSE READY"];let timer:number|undefined,stage=0;const finish=()=>{if(timer)window.clearInterval(timer);sessionStorage.setItem("guruverse-intro-seen","1");intro.classList.add("is-complete");window.setTimeout(()=>intro.remove(),700)};if(seen||reduce)finish();else{timer=window.setInterval(()=>{stage++;if(stage>=stages.length)return finish();if(status)status.textContent=stages[stage];if(progress)progress.textContent=String(stage).padStart(2,"0")+" — 04"},650);window.setTimeout(finish,2900)}skip?.addEventListener("click",finish);window.addEventListener("keydown",e=>{if(e.key==="Escape")finish()})}
</script>