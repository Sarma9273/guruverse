  <div class="gv-intro__readout" aria-hidden="true">
    <span>01</span><b>IDENTITY</b><i></i><span>02</span><b>INTELLIGENCE</b><i></i><span>03</span><b>DOCK</b>
  </div>

  <div class="gv-intro__identity" aria-hidden="true">GURU<br><span>CHARAN</span></div>
  <button class="gv-intro__skip" type="button" data-intro-skip>SKIP <span>ESC</span></button>
</div>

<style>
.gv-intro{position:fixed;inset:0;z-index:var(--z-loader);overflow:hidden;background:#010204;color:#eef8fa;isolation:isolate;opacity:1;visibility:visible;pointer-events:auto;perspective:1200px;transition:opacity 1s cubic-bezier(.77,0,.18,1),visibility 1s}
.gv-intro.is-complete{opacity:0;visibility:hidden;pointer-events:none}
.gv-intro__space,.gv-intro__stars,.gv-intro__grid,.gv-intro__vignette,.gv-intro__scanlines{position:absolute;inset:0;pointer-events:none}
.gv-intro__space{background:radial-gradient(circle at 52% 48%,rgba(0,207,230,.07),transparent 24%),radial-gradient(circle at 76% 48%,rgba(95,57,220,.055),transparent 30%),#010204}
.gv-intro__stars{opacity:.55;background-image:radial-gradient(circle,rgba(224,248,252,.7) 0 1px,transparent 1.4px),radial-gradient(circle,rgba(0,229,255,.5) 0 1px,transparent 1.5px);background-size:117px 131px,211px 179px;background-position:10px 20px,70px 90px;animation:gv-stars-drift 12s linear infinite}
.gv-intro__grid{opacity:.075;background-image:linear-gradient(rgba(155,218,226,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(155,218,226,.2) 1px,transparent 1px);background-size:80px 80px;transform:perspective(500px) rotateX(68deg) scale(1.5);transform-origin:center 72%;mask-image:linear-gradient(transparent 8%,#000 35%,transparent 100%)}
.gv-intro__vignette{z-index:20;background:radial-gradient(ellipse at center,transparent 35%,rgba(0,0,0,.32) 66%,rgba(0,0,0,.88) 100%)}
.gv-intro__scanlines{z-index:21;opacity:.05;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.22) 4px);mix-blend-mode:screen}

.gv-intro__hud{position:absolute;z-index:25;color:rgba(215,240,244,.42);font:600 .52rem/1.4 var(--font-code);letter-spacing:.13em;text-transform:uppercase}.gv-intro__hud span{display:block;color:rgba(215,240,244,.7)}.gv-intro__hud small{display:block;margin-top:.42rem;color:rgba(215,240,244,.25);font-size:.43rem}.gv-intro__hud i{display:block;width:42px;height:1px;margin-top:.5rem;background:linear-gradient(90deg,rgba(0,229,255,.6),transparent)}.gv-intro__hud--tl{left:clamp(1.2rem,4vw,4rem);top:clamp(1.2rem,4vw,3.5rem)}.gv-intro__hud--tr{right:clamp(1.2rem,4vw,4rem);top:clamp(1.2rem,4vw,3.5rem);text-align:right}.gv-intro__hud--tr i{margin-left:auto}.gv-intro__hud--bl{left:clamp(1.2rem,4vw,4rem);bottom:clamp(1.2rem,4vw,3.5rem)}

.gv-intro__orbital-field{position:absolute;left:50%;top:50%;width:min(74vw,900px);aspect-ratio:1;z-index:3;transform:translate(-50%,-50%) scale(.45);opacity:0;animation:gv-field-in 8.9s .35s cubic-bezier(.2,.7,.1,1) forwards}.gv-intro__orbital-field span{position:absolute;inset:0;border:1px solid rgba(164,228,235,.09);border-radius:50%;transform:rotateX(66deg) rotate(0);animation:gv-orbit-spin 13s linear infinite}.gv-intro__orbital-field span:nth-child(2){inset:11%;border-color:rgba(0,229,255,.12);transform:rotateY(65deg)}.gv-intro__orbital-field span:nth-child(3){inset:23%;border-color:rgba(124,77,255,.11);transform:rotateX(70deg) rotate(40deg)}.gv-intro__orbital-field span:nth-child(4){inset:-10%;border-style:dashed;border-color:rgba(164,228,235,.055);transform:rotateY(70deg) rotate(-25deg)}

.gv-intro__copy{position:absolute;left:clamp(1.2rem,7vw,7rem);top:50%;z-index:30;width:min(620px,66vw);transform:translateY(-50%);pointer-events:none;animation:gv-copy-fade 9.4s both}.gv-intro__kicker{display:block;margin-bottom:1.15rem;color:rgba(209,238,243,.44);font:600 .58rem/1 var(--font-code);letter-spacing:.2em}.gv-intro__copy h1{margin:0;font:600 clamp(3.1rem,7.6vw,8.2rem)/.8 var(--font-display);letter-spacing:-.075em;text-transform:uppercase}.gv-intro__copy h1 span,.gv-intro__copy h1 strong{display:block}.gv-intro__copy h1 strong{font-weight:700;color:#f7ffff;text-shadow:0 0 42px rgba(0,229,255,.14)}.gv-intro__copy p{margin:2rem 0 0;color:rgba(0,229,255,.7);font:600 .61rem/1 var(--font-code);letter-spacing:.17em;text-transform:uppercase}.gv-intro__progress{width:min(430px,58vw);height:1px;margin-top:.95rem;background:rgba(255,255,255,.1);overflow:hidden}.gv-intro__progress span{display:block;width:0;height:100%;background:#e9ffff;box-shadow:0 0 15px rgba(0,229,255,.9);animation:gv-progress 9.25s linear forwards}.gv-intro__copy>small{display:block;margin-top:.7rem;color:rgba(215,240,244,.25);font:500 .45rem/1 var(--font-code);letter-spacing:.12em}

.gv-intro__ship{position:absolute;left:-90px;top:3vh;width:74px;height:42px;z-index:12;opacity:0;filter:drop-shadow(0 0 18px rgba(0,229,255,.5));animation:gv-ship-cinematic 3.35s .2s cubic-bezier(.12,.72,.16,1) forwards}.ship__body{position:absolute;left:17px;top:10px;width:47px;height:22px;border:1px solid rgba(238,254,255,.9);border-radius:75% 38% 62% 43%;background:linear-gradient(100deg,rgba(4,18,24,.85),rgba(221,250,253,.85));box-shadow:inset -15px 0 14px rgba(0,229,255,.12),0 0 22px rgba(0,229,255,.35)}.ship__cockpit{position:absolute;left:38px;top:12px;width:15px;height:12px;border:1px solid rgba(0,229,255,.75);border-radius:60% 60% 35% 35%;background:rgba(0,229,255,.2);box-shadow:0 0 13px rgba(0,229,255,.6)}.ship__wing{position:absolute;top:15px;width:29px;height:16px;border:1px solid rgba(0,229,255,.45);background:linear-gradient(135deg,rgba(0,229,255,.08),transparent);clip-path:polygon(0 50%,100% 0,70% 100%)}.ship__wing--left{left:-3px;transform:rotate(-12deg)}.ship__wing--right{right:-1px;transform:scaleX(-1) rotate(-12deg)}.ship__engine{position:absolute;left:3px;top:15px;width:16px;height:8px;border-radius:50%;background:#bffcff;box-shadow:0 0 22px rgba(0,229,255,.95)}.ship__engine--two{left:-2px;top:23px;background:#8060ff;box-shadow:0 0 18px rgba(124,77,255,.85)}.ship__trail{position:absolute;right:100%;height:2px;border-radius:99px;background:linear-gradient(90deg,transparent,rgba(124,77,255,.25),rgba(0,229,255,.75));filter:blur(.5px);transform-origin:right}.ship__trail--one{top:16px;width:180px}.ship__trail--two{top:25px;width:100px;opacity:.5}

.gv-intro__core{position:absolute;left:50%;top:50%;width:min(70vw,800px);aspect-ratio:1;z-index:8;opacity:0;transform:translate(-50%,-50%) scale(.015);animation:gv-core-cinematic 4.35s 2.45s cubic-bezier(.08,.72,.13,1) forwards}.core__ring{position:absolute;border:1px solid rgba(0,229,255,.24);border-radius:50%;inset:4%;animation:gv-core-rotate 7s linear infinite}.core__ring--a{transform:rotateX(67deg)}.core__ring--b{inset:18%;border-color:rgba(124,77,255,.28);transform:rotateY(67deg);animation-duration:5.2s;animation-direction:reverse}.core__ring--c{inset:32%;border-style:dashed;border-color:rgba(226,250,253,.16);transform:rotateX(70deg) rotate(35deg);animation-duration:3.6s}.core__crosshair{position:absolute;inset:43%;border:1px solid rgba(226,250,253,.5);border-radius:50%;box-shadow:0 0 25px rgba(0,229,255,.4)}.core__crosshair:before,.core__crosshair:after{content:"";position:absolute;background:rgba(226,250,253,.28)}.core__crosshair:before{left:50%;top:-80%;width:1px;height:260%}.core__crosshair:after{top:50%;left:-80%;height:1px;width:260%}.core__energy{position:absolute;inset:37%;border-radius:50%;background:radial-gradient(circle,#fff 0 2%,#8cf6ff 3% 7%,rgba(0,229,255,.6) 12%,rgba(0,229,255,.12) 33%,transparent 69%);box-shadow:0 0 70px rgba(0,229,255,.65),0 0 170px rgba(124,77,255,.25);animation:gv-energy-pulse 1.4s ease-in-out infinite}.core__particle{position:absolute;width:4px;height:4px;border-radius:50%;background:#dfffff;box-shadow:0 0 10px #00e5ff;animation:gv-particle 2.8s ease-in-out infinite}.core__particle--a{left:25%;top:35%}.core__particle--b{right:22%;top:58%;animation-delay:.7s}.core__particle--c{left:60%;bottom:23%;animation-delay:1.2s}

.gv-intro__bot{position:absolute;left:50%;top:50%;width:min(60vw,650px);aspect-ratio:1;z-index:15;display:grid;place-items:center;opacity:0;transform:translate(-50%,-50%) scale(.015);animation:gv-bot-cinematic 5.15s 4.35s cubic-bezier(.1,.78,.12,1) forwards}.bot__halo{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,.13),transparent 48%);filter:blur(2px)}.bot__orbit{position:absolute;inset:4%;border:1px solid rgba(0,229,255,.28);border-radius:50%;transform:rotateX(68deg);animation:gv-orbit-spin 4s linear infinite}.bot__orbit--b{inset:17%;border-color:rgba(124,77,255,.25);transform:rotateY(65deg);animation-direction:reverse}.bot__body{position:relative;width:30%;height:30%;border:1px solid rgba(215,250,253,.75);border-radius:30%;background:radial-gradient(circle at 50% 35%,rgba(0,229,255,.22),rgba(3,9,14,.96) 62%);box-shadow:0 0 60px rgba(0,229,255,.35),inset 0 0 38px rgba(124,77,255,.18);transform:translateZ(30px)}.bot__body:before{content:"";position:absolute;left:-18%;right:-18%;top:48%;height:1px;background:rgba(0,229,255,.3);box-shadow:0 0 15px rgba(0,229,255,.4)}.bot__visor{position:absolute;left:18%;right:18%;top:20%;height:34%;border:1px solid rgba(0,229,255,.7);border-radius:22%;background:rgba(0,229,255,.06);display:flex;justify-content:center;align-items:center;gap:16%;box-shadow:inset 0 0 18px rgba(0,229,255,.15)}.bot__visor i{width:9%;aspect-ratio:1;border-radius:50%;background:#eaffff;box-shadow:0 0 14px #00e5ff}.bot__chest{position:absolute;left:39%;right:39%;bottom:17%;height:23%;border:1px solid rgba(0,229,255,.45);border-radius:20%;box-shadow:0 0 15px rgba(0,229,255,.22)}.bot__body b{position:absolute;top:39%;width:17%;height:10%;border:1px solid rgba(215,250,253,.35);background:rgba(0,229,255,.05)}.bot__body b:first-of-type{left:-20%;transform:rotate(-16deg)}.bot__body b:last-of-type{right:-20%;transform:rotate(16deg)}.bot__signal{position:absolute;width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 30px #00e5ff;animation:gv-signal-pulse 1s ease-in-out infinite}

.gv-intro__dock{position:absolute;right:24px;top:50%;width:150px;height:150px;z-index:7;transform:translateY(-50%) scale(.6);opacity:0;animation:gv-dock-cinematic 1.5s 7.35s cubic-bezier(.2,.8,.2,1) forwards}.dock__outer,.dock__inner,.dock__target{position:absolute;inset:0;border:1px solid rgba(0,229,255,.16);border-radius:50%}.dock__outer{box-shadow:0 0 65px rgba(0,229,255,.08),inset 0 0 35px rgba(0,229,255,.06)}.dock__inner{inset:18%;border-color:rgba(0,229,255,.28);transform:rotate(30deg) scaleX(1.2)}.dock__target{inset:37%;border-color:rgba(0,229,255,.75);box-shadow:0 0 35px rgba(0,229,255,.35)}.gv-intro__dock:after{content:"";position:absolute;left:-45px;top:50%;width:45px;height:1px;background:linear-gradient(90deg,transparent,rgba(0,229,255,.45));box-shadow:0 0 10px rgba(0,229,255,.3)}.gv-intro__dock small{position:absolute;right:calc(100% + 8px);top:calc(50% + 12px);white-space:nowrap;color:rgba(215,240,244,.32);font:600 .46rem var(--font-code);letter-spacing:.12em}

.gv-intro__readout{position:absolute;right:clamp(1.2rem,5vw,5rem);bottom:clamp(4rem,9vw,7rem);z-index:25;display:flex;align-items:center;gap:.55rem;color:rgba(215,240,244,.3);font:500 .45rem var(--font-code);letter-spacing:.12em}.gv-intro__readout b{font-weight:600;color:rgba(215,240,244,.52)}.gv-intro__readout i{width:24px;height:1px;background:rgba(0,229,255,.2)}.gv-intro__identity{position:absolute;right:clamp(1.2rem,5vw,5rem);top:clamp(4.6rem,10vw,7rem);z-index:25;text-align:right;font:700 .78rem/1 var(--font-display);letter-spacing:.27em}.gv-intro__identity span{color:rgba(0,229,255,.6);font-size:.7em;letter-spacing:.4em}.gv-intro__skip{position:absolute;right:clamp(1.2rem,4vw,3.5rem);bottom:clamp(1.2rem,3vw,2.4rem);z-index:40;border:0;background:none;color:rgba(238,248,250,.3);font:600 .5rem var(--font-code);letter-spacing:.16em;cursor:pointer}.gv-intro__skip:hover{color:#eaffff}.gv-intro__skip span{margin-left:.5rem;color:rgba(0,229,255,.6)}

@keyframes gv-stars-drift{to{background-position:130px 80px,10px 10px}}
@keyframes gv-field-in{0%{opacity:0;transform:translate(-50%,-50%) scale(.42)}18%{opacity:.7}100%{opacity:.5;transform:translate(-50%,-50%) scale(1)}}
@keyframes gv-orbit-spin{to{transform:rotateX(66deg) rotate(360deg)}}
@keyframes gv-ship-cinematic{0%{left:-90px;top:4vh;opacity:0;transform:rotate(18deg) scale(.22)}12%{opacity:1}42%{left:18vw;top:18vh;transform:rotate(13deg) scale(.7)}72%{left:42vw;top:39vh;transform:rotate(8deg) scale(1.8)}91%{left:50%;top:50%;transform:translate(-50%,-50%) rotate(0) scale(4.8);opacity:1}100%{left:50%;top:50%;transform:translate(-50%,-50%) rotate(0) scale(7);opacity:0}}
@keyframes gv-core-cinematic{0%{opacity:0;transform:translate(-50%,-50%) scale(.015)}17%{opacity:.4}42%{opacity:1;transform:translate(-50%,-50%) scale(.38)}73%{transform:translate(-50%,-50%) scale(1)}100%{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@keyframes gv-bot-cinematic{0%{opacity:0;transform:translate(-50%,-50%) scale(.015)}12%{opacity:.7}31%{opacity:1;transform:translate(-50%,-50%) scale(.18)}55%{transform:translate(-50%,-50%) scale(1)}67%{transform:translate(-50%,-50%) scale(1)}84%{transform:translate(-50%,-50%) scale(.34)}100%{opacity:1;left:calc(100% - 99px);top:50%;transform:translate(-50%,-50%) scale(.18)}}
@keyframes gv-dock-cinematic{0%{opacity:0;transform:translateY(-50%) scale(.6)}50%{opacity:1}100%{opacity:1;transform:translateY(-50%) scale(1)}}
@keyframes gv-core-rotate{to{transform:rotateX(67deg) rotate(360deg)}}@keyframes gv-energy-pulse{50%{transform:scale(1.18);filter:brightness(1.25)}}@keyframes gv-particle{50%{transform:translate(18px,-24px);opacity:.2}}@keyframes gv-signal-pulse{50%{transform:scale(1.8);opacity:.4}}@keyframes gv-progress{to{width:100%}}@keyframes gv-copy-fade{0%,22%{opacity:0;transform:translateY(-46%)}27%,72%{opacity:1;transform:translateY(-50%)}86%,100%{opacity:0;transform:translateY(-54%)}} 

@media(max-width:700px){.gv-intro__copy{left:1rem;width:86vw}.gv-intro__copy h1{font-size:clamp(3rem,14vw,5.8rem)}.gv-intro__hud--tr,.gv-intro__readout{display:none}.gv-intro__dock{right:8px;width:105px;height:105px}.gv-intro__dock small{display:none}.gv-intro__identity{right:1rem;top:4.4rem}.gv-intro__grid{background-size:55px 55px}.gv-intro__bot{width:82vw}}
@media(prefers-reduced-motion:reduce){.gv-intro__stars,.gv-intro__orbital-field span,.gv-intro__core .core__ring{animation:none}.gv-intro__ship,.gv-intro__core,.gv-intro__bot,.gv-intro__dock,.gv-intro__copy,.gv-intro__progress span{animation:none}.gv-intro__core{opacity:1;transform:translate(-50%,-50%) scale(1)}.gv-intro__bot{opacity:1;left:calc(100% - 99px);top:50%;transform:translate(-50%,-50%) scale(.18)}.gv-intro__dock{opacity:1;transform:translateY(-50%) scale(1)}.gv-intro__copy{opacity:1;transform:translateY(-50%)}.gv-intro__progress span{width:100%}}
</style>

<script>
const intro=document.querySelector<HTMLElement>("[data-cinematic-intro]");
if(intro){
  const skip=intro.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const status=intro.querySelector<HTMLElement>("[data-intro-status]");
  const code=intro.querySelector<HTMLElement>("[data-intro-code]");
  const reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stages=[
    ["ESTABLISHING SECURE LINK","VECTOR 01 · ENTRY"],
    ["NAVIGATING IDENTITY CORE","VECTOR 02 · ORBIT LOCK"],
    ["INTELLIGENCE CORE ONLINE","VECTOR 03 · CORE WAKE"],
    ["GURU-BOT DEPLOYED","VECTOR 04 · DOCK APPROACH"],
    ["DOCK 01 · SYSTEM READY","VECTOR 05 · LANDING"]
  ];
  let stage=0;
  let timer:number|undefined;
  let finishTimer:number|undefined;
  const finish=()=>{
    if(timer) window.clearInterval(timer);
    if(finishTimer) window.clearTimeout(finishTimer);
    intro.classList.add("is-complete");
    window.setTimeout(()=>intro.remove(),1000);
  };
  const advance=()=>{
    stage=Math.min(stage+1,stages.length-1);
    if(status) status.textContent=stages[stage][0];
    if(code) code.textContent=stages[stage][1];
  };
  if(reduce){
    if(status) status.textContent="CINEMATIC BOOT READY";
    if(code) code.textContent="REDUCED MOTION · STATIC STATE";
    finishTimer=window.setTimeout(finish,5200);
  }else{
    timer=window.setInterval(advance,1750);
    finishTimer=window.setTimeout(finish,9600);
  }
  skip?.addEventListener("click",finish);
  window.addEventListener("keydown",e=>{if(e.key==="Escape") finish()});
}
</script>