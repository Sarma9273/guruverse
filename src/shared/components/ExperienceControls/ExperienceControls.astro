---
import "./ExperienceControls.css";
---
<div class="experience-controls" aria-label="GURUVERSE experience controls">
  <span class="experience-controls__label">MODE</span>
  <div class="experience-controls__modes" role="group" aria-label="Experience mode">
    <button type="button" data-mode="recruiter" aria-pressed="false">Recruiter</button>
    <button type="button" data-mode="explorer" aria-pressed="true">Explorer</button>
    <button type="button" data-mode="developer" aria-pressed="false">Developer</button>
  </div>
  <button type="button" class="experience-controls__search" data-command-open aria-label="Open command palette"><span>⌘K / Ctrl K</span></button>
</div>
<dialog class="command-palette" data-command-palette aria-label="GURUVERSE command palette">
  <form method="dialog" class="command-palette__panel">
    <div class="command-palette__header">
      <input data-command-input type="search" placeholder="Search GURUVERSE..." aria-label="Search GURUVERSE" autocomplete="off" />
      <button value="cancel" aria-label="Close command palette">Esc</button>
    </div>
    <div class="command-palette__results" data-command-results></div>
  </form>
</dialog>
<section class="developer-console" data-developer-console aria-label="Developer mode">
  <div><span>DEVELOPER MODE</span><h2>System Architecture</h2><p>Astro static rendering → feature modules → shared interaction layer → project data → GURU-BOT.</p></div>
  <dl><div><dt>Rendering</dt><dd>Astro / static-first</dd></div><div><dt>Language</dt><dd>TypeScript</dd></div><div><dt>Content</dt><dd>Feature-owned data</dd></div><div><dt>Interaction</dt><dd>Local client modules</dd></div></dl>
</section>
<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll("[data-mode]")];
  const palette = document.querySelector("[data-command-palette]");
  const input = document.querySelector("[data-command-input]");
  const results = document.querySelector("[data-command-results]");
  const openButton = document.querySelector("[data-command-open]");
  const base = root.dataset.base || "/guruverse/";
  const withBase = (path) => `${base.replace(/\/$/, "")}${path}`;
  const commands = [
    { label:"Universe", href:withBase("/#hero"), keywords:"home hero explorer" },
    { label:"Projects", href:withBase("/#projects"), keywords:"work portfolio systems" },
    { label:"Timeline", href:withBase("/#timeline"), keywords:"journey experience" },
    { label:"Research", href:withBase("/#research"), keywords:"papers research" },
    { label:"About", href:withBase("/#about"), keywords:"profile skills" },
    { label:"Contact", href:withBase("/#contact"), keywords:"contact reach" },
    { label:"Resume", href:withBase("/resume/"), keywords:"cv resume recruiter" },
    { label:"Projects Index", href:withBase("/projects/"), keywords:"projects all systems" }
  ];
  function setMode(mode){ root.dataset.gvMode=mode; buttons.forEach(button=>button.setAttribute("aria-pressed",String(button.dataset.mode===mode))); try{localStorage.setItem("gv-mode",mode)}catch{} }
  function renderResults(query=""){ if(!results)return; const q=query.trim().toLowerCase(); const filtered=commands.filter(item=>!q||`${item.label} ${item.keywords}`.toLowerCase().includes(q)); results.innerHTML=filtered.length?filtered.map(item=>`<a href="${item.href}"><span>${item.label}</span><small>${item.keywords}</small></a>`).join(""):"<p>No matching GURUVERSE destination.</p>"; }
  buttons.forEach(button=>button.addEventListener("click",()=>setMode(button.dataset.mode||"explorer")));
  openButton?.addEventListener("click",()=>{renderResults();palette?.showModal();input?.focus()});
  input?.addEventListener("input",()=>renderResults(input.value));
  palette?.addEventListener("click",event=>{if(event.target===palette)palette.close()});
  document.addEventListener("keydown",event=>{if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==="k"){event.preventDefault();renderResults();palette?.showModal();input?.focus()}});
  try{setMode(localStorage.getItem("gv-mode")||"explorer")}catch{setMode("explorer")}
</script>