---
interface Props {
    label?: string;
}

const {
    label = "Open GURU-BOT",
} = Astro.props;
---

<button
    class="guru-bot"
    type="button"
    aria-label={label}
    aria-expanded="false"
    aria-controls="guru-bot-panel"
>
    <span class="guru-bot__core">
        <span class="guru-bot__pulse"></span>
        <span class="guru-bot__eye guru-bot__eye--left"></span>
        <span class="guru-bot__eye guru-bot__eye--right"></span>
    </span>

    <span class="guru-bot__orbit guru-bot__orbit--one"></span>
    <span class="guru-bot__orbit guru-bot__orbit--two"></span>

    <span class="guru-bot__status">
        GURU-BOT
    </span>
</button>

<section
    id="guru-bot-panel"
    class="guru-bot-panel"
    aria-hidden="true"
>
    <div class="guru-bot-panel__header">
        <div>
            <span class="guru-bot-panel__eyebrow">
                GURUVERSE AI
            </span>

            <h2>GURU-BOT</h2>
        </div>

        <button
            class="guru-bot-panel__close"
            type="button"
            aria-label="Close GURU-BOT"
        >
            ×
        </button>
    </div>

    <div class="guru-bot-panel__body">
        <div class="guru-bot-panel__indicator"></div>

        <p>
            GURU-BOT is initializing.
        </p>

        <span>
            Interactive intelligence will be connected here.
        </span>
    </div>

    <div class="guru-bot-panel__footer">
        SYSTEM ONLINE
    </div>
</section>

<style>
    .guru-bot {
        position: fixed;

        right: 28px;
        bottom: 28px;

        width: 72px;
        height: 72px;

        z-index: var(--z-robot);

        display: grid;
        place-items: center;

        border:
            1px solid
            rgba(0, 229, 255, 0.35);

        border-radius: 50%;

        background:
            rgba(4, 7, 13, 0.72);

        backdrop-filter:
            blur(16px);

        -webkit-backdrop-filter:
            blur(16px);

        box-shadow:
            0 0 24px
            rgba(0, 229, 255, 0.12);

        color: var(--color-text);

        cursor: pointer;

        transition:
            transform var(--speed-normal),
            border-color var(--speed-normal),
            box-shadow var(--speed-normal);
    }

    .guru-bot:hover {
        transform: scale(1.08);

        border-color:
            var(--color-primary);

        box-shadow:
            0 0 36px
            rgba(0, 229, 255, 0.28);
    }

    .guru-bot__core {
        position: relative;

        width: 30px;
        height: 24px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        border:
            1px solid
            rgba(0, 229, 255, 0.65);

        border-radius: 9px;

        background:
            rgba(0, 229, 255, 0.08);

        box-shadow:
            inset 0 0 12px
            rgba(0, 229, 255, 0.08);
    }

    .guru-bot__eye {
        width: 5px;
        height: 5px;

        border-radius: 50%;

        background:
            var(--color-primary);

        box-shadow:
            0 0 8px
            rgba(0, 229, 255, 0.8);
    }

    .guru-bot__pulse {
        position: absolute;

        inset: 0;

        border-radius: inherit;

        border:
            1px solid
            rgba(0, 229, 255, 0.4);

        animation:
            guru-bot-pulse
            2.4s
            ease-in-out
            infinite;
    }

    .guru-bot__orbit {
        position: absolute;

        inset: 8px;

        border:
            1px solid
            rgba(0, 229, 255, 0.16);

        border-radius: 50%;

        pointer-events: none;
    }

    .guru-bot__orbit--one {
        transform: rotate(35deg) scaleX(1.35);

        animation:
            guru-bot-orbit
            7s
            linear
            infinite;
    }

    .guru-bot__orbit--two {
        transform: rotate(-35deg) scaleX(1.35);

        border-color:
            rgba(124, 77, 255, 0.16);

        animation:
            guru-bot-orbit-reverse
            9s
            linear
            infinite;
    }

    .guru-bot__status {
        position: absolute;

        right: 4px;
        bottom: -20px;

        color:
            var(--color-primary);

        font-family:
            var(--font-code);

        font-size:
            0.55rem;

        font-weight: 700;

        letter-spacing:
            0.08rem;

        white-space: nowrap;

        opacity: 0.7;
    }

    @keyframes guru-bot-pulse {

        0%,
        100% {
            opacity: 0.25;
            transform: scale(0.85);
        }

        50% {
            opacity: 0.8;
            transform: scale(1.08);
        }
    }

    @keyframes guru-bot-orbit {

        from {
            transform:
                rotate(35deg)
                scaleX(1.35);
        }

        to {
            transform:
                rotate(395deg)
                scaleX(1.35);
        }
    }

    @keyframes guru-bot-orbit-reverse {

        from {
            transform:
                rotate(-35deg)
                scaleX(1.35);
        }

        to {
            transform:
                rotate(-395deg)
                scaleX(1.35);
        }
    }

    @media (max-width: 768px) {

        .guru-bot {
            right: 18px;
            bottom: 18px;

            width: 62px;
            height: 62px;
        }

        .guru-bot__status {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {

        .guru-bot__pulse,
        .guru-bot__orbit {
            animation: none;
        }

        .guru-bot {
            transition: none;
        }
    }

    /* ==========================================================
   GURU-BOT INTERACTION PANEL
   ========================================================== */

.guru-bot--active {
    border-color: var(--color-primary);

    box-shadow:
        0 0 32px
        rgba(0, 229, 255, 0.3);
}

.guru-bot-panel {
    position: fixed;

    right: 28px;
    bottom: 118px;

    width: min(
        380px,
        calc(100vw - 40px)
    );

    z-index: calc(var(--z-robot) + 1);

    padding: var(--space-6);

    border:
        1px solid
        rgba(0, 229, 255, 0.18);

    border-radius:
        var(--radius-xl);

    background:
        rgba(4, 7, 13, 0.88);

    backdrop-filter:
        blur(24px);

    -webkit-backdrop-filter:
        blur(24px);

    box-shadow:
        0 24px 80px
        rgba(0, 0, 0, 0.45),
        0 0 40px
        rgba(0, 229, 255, 0.08);

    opacity: 0;
    visibility: hidden;

    transform:
        translateY(16px)
        scale(0.96);

    transform-origin:
        bottom right;

    pointer-events: none;

    transition:
        opacity var(--speed-normal),
        transform var(--speed-normal),
        visibility var(--speed-normal);
}

.guru-bot-panel--open {
    opacity: 1;

    visibility: visible;

    transform:
        translateY(0)
        scale(1);

    pointer-events: auto;
}

.guru-bot-panel__header {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    gap: var(--space-4);

    padding-bottom: var(--space-5);

    border-bottom:
        1px solid
        var(--color-border);
}

.guru-bot-panel__eyebrow {
    display: block;

    margin-bottom: var(--space-2);

    color: var(--color-primary);

    font-family: var(--font-code);

    font-size: var(--text-xs);

    letter-spacing: .12rem;
}

.guru-bot-panel__header h2 {
    color: var(--color-text);

    font-size: var(--text-2xl);
}

.guru-bot-panel__close {
    width: 32px;
    height: 32px;

    display: grid;
    place-items: center;

    border:
        1px solid
        var(--color-border);

    border-radius: 50%;

    color: var(--color-text-muted);

    font-size: 1.25rem;

    transition:
        color var(--speed-fast),
        border-color var(--speed-fast),
        background var(--speed-fast);
}

.guru-bot-panel__close:hover {
    color: var(--color-primary);

    border-color:
        var(--color-primary);

    background:
        rgba(0, 229, 255, 0.06);
}

.guru-bot-panel__body {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: var(--space-3);

    padding:
        var(--space-6)
        0;
}

.guru-bot-panel__indicator {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background:
        var(--color-accent);

    box-shadow:
        0 0 12px
        rgba(0, 255, 163, 0.7);

    animation:
        guru-bot-status
        2s
        ease-in-out
        infinite;
}

.guru-bot-panel__body p {
    color: var(--color-text);

    font-size: var(--text-lg);
}

.guru-bot-panel__body span {
    color: var(--color-text-muted);

    font-size: var(--text-sm);

    line-height: 1.7;
}

.guru-bot-panel__footer {
    padding-top: var(--space-4);

    border-top:
        1px solid
        var(--color-border);

    color: var(--color-accent);

    font-family: var(--font-code);

    font-size: var(--text-xs);

    letter-spacing: .08rem;
}

@keyframes guru-bot-status {

    0%,
    100% {
        opacity: .45;
        transform: scale(.8);
    }

    50% {
        opacity: 1;
        transform: scale(1);
    }
}

@media (max-width: 768px) {

    .guru-bot-panel {
        right: 18px;
        bottom: 96px;

        width: calc(100vw - 36px);
    }
}

@media (prefers-reduced-motion: reduce) {

    .guru-bot-panel,
    .guru-bot-panel__close {
        transition: none;
    }

    .guru-bot-panel__indicator {
        animation: none;
    }
}
</style>

<script>
    const bot = document.querySelector<HTMLElement>(".guru-bot");
    const panel = document.querySelector<HTMLElement>("#guru-bot-panel");
    const close = document.querySelector<HTMLButtonElement>(
        ".guru-bot-panel__close"
    );

    if (bot && panel && close) {

        const setOpen = (open: boolean) => {
            bot.setAttribute(
                "aria-expanded",
                String(open)
            );

            panel.setAttribute(
                "aria-hidden",
                String(!open)
            );

            panel.classList.toggle(
                "guru-bot-panel--open",
                open
            );

            bot.classList.toggle(
                "guru-bot--active",
                open
            );
        };

        bot.addEventListener("click", () => {
            const isOpen =
                bot.getAttribute("aria-expanded") === "true";

            setOpen(!isOpen);
        });

        close.addEventListener("click", () => {
            setOpen(false);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                setOpen(false);
            }
        });
    }
</script>