---
import "./GuruBot.css";
import "./GuruBot-final.css";
interface Props { label?: string; project?: { title:string; tagline:string; description:string; category:string; status:string; technologies:string[]; }; }
const { label = "Open GURU-BOT", project } = Astro.props;
---
<div class="guru-bot-idle-ui" aria-hidden="true"><div class="guru-bot-help-bubble">MAY I HELP YOU?<span>GURU-BOT / STANDING BY</span></div><div class="guru-bot-prank-message">ARE YOU THERE?<span>SCREEN INTEGRITY RESTORED</span></div><div class="guru-bot-sleep-message">GURU-BOT SLEEP MODE<span>ENERGY LINK · CHARGING · SYSTEM REST</span></div><div class="guru-bot-crack"><i></i><i></i><i></i><i></i><i></i></div></div>
<button class="guru-bot-dock" type="button" aria-label="Open GURU-BOT" aria-controls="guru-bot-panel"><span class="guru-bot-dock__halo"></span><span class="guru-bot-dock__ring"></span><span class="guru-bot-dock__charging-bay"><span class="guru-bot-dock__battery"><i></i><b>+</b></span><span class="guru-bot-dock__plug"><i></i><b></b></span><span class="guru-bot-dock__charge-flow"></span></span><span class="guru-bot-dock__label">GURU-BOT / DOCK 01</span><span class="guru-bot-dock__charging-label">ENERGY LINK · CHARGING</span></button>
<button class="guru-bot" type="button" aria-label={label} aria-expanded="false" aria-controls="guru-bot-panel">
  <span class="guru-bot__jetpack" aria-hidden="true"><i></i><i></i><span class="guru-bot__smoke"><b></b><b></b><b></b><b></b><b></b></span></span><span class="guru-bot__torso" aria-hidden="true"><span class="guru-bot__neck"></span><span class="guru-bot__chest"></span><span class="guru-bot__shoulder guru-bot__shoulder--left"></span><span class="guru-bot__shoulder guru-bot__shoulder--right"></span><span class="guru-bot__arm guru-bot__arm--left"></span><span class="guru-bot__arm guru-bot__arm--right"></span><span class="guru-bot__leg guru-bot__leg--left"></span><span class="guru-bot__leg guru-bot__leg--right"></span><span class="guru-bot__knee guru-bot__knee--left"></span><span class="guru-bot__knee guru-bot__knee--right"></span></span><span class="guru-bot__core"><span class="guru-bot__pulse"></span><span class="guru-bot__eye guru-bot__eye--left"></span><span class="guru-bot__eye guru-bot__eye--right"></span></span>
  <span class="guru-bot__orbit guru-bot__orbit--one"></span><span class="guru-bot__orbit guru-bot__orbit--two"></span>
  <span class="guru-bot__status">GURU-BOT</span>
</button>
<section id="guru-bot-panel" class="guru-bot-panel" aria-hidden="true">
  <div class="guru-bot-panel__header">
    <div><span class="guru-bot-panel__eyebrow">GURUVERSE INTELLIGENCE</span><h2>GURU-BOT</h2></div>
    <div class="guru-bot-panel__controls"><button class="guru-bot__clear" type="button" data-guru-clear aria-label="Clear GURU-BOT chat">Clear</button><button class="guru-bot-panel__close" type="button" aria-label="Close GURU-BOT">×</button></div>
  </div>
  <div class="guru-bot-panel__body">
    <div class="guru-bot-panel__indicator"></div>
    <div class="guru-bot__modebar" role="group" aria-label="GURU-BOT mode">
      <button type="button" data-guru-mode="explore" class="is-active">Explore</button>
      <button type="button" data-guru-mode="recruiter">Recruiter</button>
      <button type="button" data-guru-mode="engineer">Engineer</button>
      <button type="button" data-guru-mode="researcher">Researcher</button>
    </div>
    {project && <div class="guru-bot__project"><span class="guru-bot__project-label">CURRENT PROJECT</span><h3 class="guru-bot__project-title">{project.title}</h3><p class="guru-bot__project-tagline">{project.tagline}</p></div>}
    <div class="guru-bot__actions">
      <button type="button" class="guru-bot__action" data-guru-action="What is GURUVERSE?">What is this system?</button>
      <button type="button" class="guru-bot__action" data-guru-action="Explain the architecture">Architecture</button>
      <button type="button" class="guru-bot__action" data-guru-action="Show the evidence">Evidence</button>
      <button type="button" class="guru-bot__action" data-guru-action="What are the limitations?">Boundaries</button>
    </div>
    <div class="guru-bot__conversation" data-guru-conversation aria-live="polite"></div>
    <form class="guru-bot__ask" data-guru-form>
      <label class="sr-only" for="guru-bot-input">Ask GURU-BOT</label>
      <input id="guru-bot-input" data-guru-input type="text" autocomplete="off" placeholder="Ask about projects, research, journey…" />
      <button type="submit">Ask</button>
    </form>
    <div class="guru-bot__response" data-guru-response aria-live="polite"></div>
  </div>
  <div class="guru-bot-panel__footer">LOCAL KNOWLEDGE · NO EXTERNAL AI API</div>
</section>
<script>import "./GuruBot.ts";</script>

<script is:inline>
(() => {
  const html = document.documentElement;
  const revealRestingBot = () => {
    if (!html.classList.contains("guruverse-docked")) return;
    document.querySelector(".guru-bot-dock")?.classList.remove("guru-bot-dock--screen-hidden");
    document.querySelector(".guru-bot")?.classList.remove("guru-bot--screen-hidden");
    observer.disconnect();
  };
  const observer = new MutationObserver(revealRestingBot);
  observer.observe(html, { attributes: true, attributeFilter: ["class"] });
  revealRestingBot();
})();
</script>
