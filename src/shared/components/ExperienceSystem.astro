---
const input = document.querySelector("[data-command-input]");
const results = document.querySelector("[data-command-results]");
const base = document.documentElement.dataset.base || "/guruverse/";
const withBase = (path) => base.replace(/\/$/, "") + path;

const items = [
  { label: "Universe", href: withBase("/#hero"), keywords: "home hero explore" },
  { label: "Projects", href: withBase("/projects/"), keywords: "projects systems work" },
  { label: "RA-XSOC", href: withBase("/projects/ra-xsoc/"), keywords: "security soc ai cybersecurity" },
  { label: "CyberGPT", href: withBase("/projects/cybergpt/"), keywords: "security incident response ai" },
  { label: "GURUVERSE", href: withBase("/projects/guruverse/"), keywords: "portfolio architecture" },
  { label: "Research", href: withBase("/research/"), keywords: "research papers algorithms methodology evidence" },
  { label: "Timeline", href: withBase("/#timeline"), keywords: "career experience timeline" },
  { label: "About", href: withBase("/#about"), keywords: "about profile" },
  { label: "Contact", href: withBase("/#contact"), keywords: "contact connect" },
];

if (input && results) {
  const render = () => {
    const query = input.value.trim().toLowerCase();
    const matches = items.filter((item) => !query || (item.label + " " + item.keywords).toLowerCase().includes(query));
    results.innerHTML = matches.slice(0, 8).map((item) => '<a href="' + item.href + '">' + item.label + '</a>').join("");
  };
  input.addEventListener("input", render);
  render();
}
