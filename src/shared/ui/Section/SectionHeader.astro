---
import "./section.css";
interface Props{

    eyebrow:string;

    title:string;

    description?:string;

    align?:

        | "left"

        | "center";

}

const{

    eyebrow,

    title,

    description,

    align="center"

}=Astro.props;
---

<header

    class={`section-header section-header--${align}`}

>

    <span class="section-header__eyebrow">

        {eyebrow}

    </span>

    <h2 class="section-header__title">

        {title}

    </h2>

    {

        description && (

            <p class="section-header__description">

                {description}

            </p>

        )

    }

</header>