---
import { featuredResearch } from "./data/research";
import ResearchCard from "./components/ResearchCard.astro";
import "./styles/research.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="research" class="research">
  <div class="research__container">
    <div class="research__header">
      <div>
        <span class="research__eyebrow">RESEARCH / 04</span>
        <h2>Engineering questions, made inspectable.</h2>
      </div>
      <p>
        Research is shown as a traceable record of questions, methods, evidence,
        boundaries, and the next investigation—not as unsupported publication badges.
      </p>
    </div>

    <div class="research__signal">
      <span>INQUIRY → METHOD → EVIDENCE → NEXT</span>
      <div aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    </div>

    <div class="research__grid">
      {featuredResearch.slice(0, 3).map((item) => <ResearchCard research={item} />)}
    </div>

    <div class="research__footer">
      <span>{featuredResearch.length} active research records</span>
      <a href={base + "/research/"}>Enter Research Universe ↗</a>
    </div>
  </div>
</section>
