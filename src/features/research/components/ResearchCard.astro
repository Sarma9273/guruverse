---
import type { Research } from "../types/research";
interface Props { research: Research; }
const { research } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<article class="research-card">
  <div class="research-card__top">
    <span class="research-card__kind">{research.kind}</span>
    <span class={'research-card__status research-card__status--' + research.status.toLowerCase()}>{research.status}</span>
  </div>
  <p class="research-card__category">{research.category}</p>
  <h3>{research.title}</h3>
  <p class="research-card__description">{research.summary}</p>
  <div class="research-card__tech">
    {research.technologies.map((technology) => <span>{technology}</span>)}
  </div>
  <div class="research-card__footer">
    <span>RECORD / {research.id.toUpperCase()}</span>
    <a href={base + "/research/" + research.id + "/"}>Inspect ↗</a>
  </div>
</article>
