---
const { research } = Astro.props;
---

<article class="research-card">

    <span class="research-card__category">

        {research.category}

    </span>

    <h3>

        {research.title}

    </h3>

    <p>

        {research.description}

    </p>

    <div class="research-card__tech">

        {

            research.technologies.map(

                (tech:string)=>(

                    <span>{tech}</span>

                )

            )

        }

    </div>

    <span class="research-card__status">

        {research.status}

    </span>

</article>