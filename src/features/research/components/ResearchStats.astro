---
import { research } from "../data/research";
const completed = research.filter((item) => item.status === "Completed").length;
const ongoing = research.filter((item) => item.status === "Ongoing").length;
const future = research.filter((item) => item.status === "Future").length;
---

<div class="research-stats" aria-label="Research index summary">
  <div><strong>{research.length}</strong><span>Research tracks</span></div>
  <div><strong>{completed}</strong><span>Completed records</span></div>
  <div><strong>{ongoing}</strong><span>Active tracks</span></div>
  <div><strong>{future}</strong><span>Future directions</span></div>
</div>
