---
import type { Project } from "../types/project";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a
    href={`${base}/projects/${project.id}/`}
    class="project-card motion-reveal motion-interactive"
>
    {
        project.featured && (
            <span class="project-card__featured">
                ★ Featured
            </span>
        )
    }

    <div class="project-card__image" aria-label={`${project.title} visual placeholder`}>
        <img
            src={`${base}${project.image.startsWith("/") ? project.image : `/${project.image}`}`}
            alt=""
            loading="lazy"
            aria-hidden="true"
            onerror="this.style.display='none'"
        />
        <div class="project-card__space" aria-hidden="true">
            <span class="project-card__space-orbit project-card__space-orbit--one"></span>
            <span class="project-card__space-orbit project-card__space-orbit--two"></span>
            <span class="project-card__space-core"></span>
            <span class="project-card__space-label">{project.title}</span>
        </div>
    </div>

    <div class="project-card__content">

        <span class="project-card__category">
            {project.category}
        </span>

        <h3>
            {project.title}
        </h3>

        <p class="project-card__tagline">
            {project.tagline}
        </p>

        <p class="project-card__description">
            {project.description}
        </p>

        <div class="project-card__tech">

            {
                project.technologies.map((tech) => (
                    <span>
                        {tech}
                    </span>
                ))
            }

        </div>

        <div class="project-card__footer">

            <span class="project-card__status">
                {project.status}
            </span>

            <span class="project-card__cta">
                Explore →
            </span>

        </div>

    </div>
</a>
