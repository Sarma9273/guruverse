---
interface Metric {
    label: string;
    value: string;
}

interface Props {
    metrics?: Metric[];
}

const {
    metrics = []
} = Astro.props;
---

{
    metrics.length > 0 && (
        <section
            class="project-metrics"
            aria-label="Project metrics"
        >

            {
                metrics.map((metric, index) => (
                    <article
                        class="project-metric"
                        tabindex="0"
                    >

                        <span class="project-metric__index">
                            {String(index + 1).padStart(2, "0")}
                        </span>

                        <div class="project-metric__value">
                            {metric.value}
                        </div>

                        <p class="project-metric__label">
                            {metric.label}
                        </p>

                        <span
                            class="project-metric__signal"
                            aria-hidden="true"
                        />

                    </article>
                ))
            }

        </section>
    )
}