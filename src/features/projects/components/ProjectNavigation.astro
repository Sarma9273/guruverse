---
import type { Project } from "../types/project";
interface Props { projects: Project[]; currentSlug: string; }
const { projects, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const index = projects.findIndex((project) => project.id === currentSlug);
const previous = index > 0 ? projects[index - 1] : null;
const next = index >= 0 && index < projects.length - 1 ? projects[index + 1] : null;
---
<nav class="project-navigation" aria-label="Project navigation">
  <a href={`${base}/projects/`} class="project-navigation__index" aria-label="Back to all projects">All Projects</a>
  {previous && <a href={`${base}/projects/${previous.id}/`} rel="prev">← {previous.title}</a>}
  {next && <a href={`${base}/projects/${next.id}/`} rel="next">{next.title} →</a>}
</nav>