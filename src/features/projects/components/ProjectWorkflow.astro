---
interface Props {
    workflow: string[];
}

const { workflow } = Astro.props;
---

<div class="project-workflow">

    {
        workflow.map((step, index) => (
            <div
                class="project-workflow__step"
                tabindex="0"
                data-workflow-step
            >

                <div class="project-workflow__number">
                    {String(index + 1).padStart(2, "0")}
                </div>

                <div class="project-workflow__content">
                    <span class="project-workflow__label">
                        STEP {String(index + 1).padStart(2, "0")}
                    </span>

                    <p>
                        {step}
                    </p>
                </div>

                <div
                    class="project-workflow__signal"
                    aria-hidden="true"
                />
            </div>
        ))
    }

</div>

<script>
    const steps =
        document.querySelectorAll<HTMLElement>(
            "[data-workflow-step]"
        );

    steps.forEach((step) => {
        step.addEventListener("mouseenter", () => {
            steps.forEach((item) =>
                item.classList.remove(
                    "project-workflow__step--active"
                )
            );

            step.classList.add(
                "project-workflow__step--active"
            );
        });

        step.addEventListener("focus", () => {
            steps.forEach((item) =>
                item.classList.remove(
                    "project-workflow__step--active"
                )
            );

            step.classList.add(
                "project-workflow__step--active"
            );
        });
    });
</script>