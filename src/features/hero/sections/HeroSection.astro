---
import HeroBackground from "../components/HeroBackground.astro";
import HeroContent from "../components/HeroContent.astro";
import HeroCTA from "../components/HeroCTA.astro";
import HeroStats from "../components/HeroStats.astro";
import "../styles/hero.css";
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <HeroBackground />
  <div class="hero__frame">
    <div class="hero__copy"><HeroContent /><HeroCTA /><HeroStats /></div>
    <div class="hero-portrait" aria-label="Identity reveal portrait of Guru Charan Mavuduru">
      <div class="hero-portrait__halo"></div>
      <div class="hero-portrait__ring hero-portrait__ring--one"></div>
      <div class="hero-portrait__ring hero-portrait__ring--two"></div>
      <div class="hero-portrait__frame">
        <img id="guru-portrait-source" src="./images/profile.jpeg?v=9" alt="Portrait of Guru Charan Mavuduru" width="640" height="800" fetchpriority="high" decoding="async" />
        <canvas class="hero-portrait__particles" aria-hidden="true"></canvas>
        <div class="hero-portrait__binary" aria-hidden="true"></div>
        <span class="hero-portrait__scan"></span>
      </div>
      <div class="hero-portrait__verify" aria-live="polite"><span></span><b>IDENTITY VERIFICATION</b><small data-identity-status>SCANNING SUBJECT / 001</small></div>
      <div class="hero-portrait__label"><span>SUBJECT / 001</span><strong>GURU CHARAN MAVUDURU</strong><small>AI &amp; DATA SCIENCE · SECURITY · SOFTWARE · RESEARCH</small></div>
    </div>
  </div>
  <a class="hero-scroll" href="#about" aria-label="Continue to identity"><span>CONTINUE EXPLORATION</span><i></i></a>
</section>
<script>
const portrait=document.querySelector<HTMLImageElement>("#guru-portrait-source");
const canvas=document.querySelector<HTMLCanvasElement>(".hero-portrait__particles");
const frame=document.querySelector<HTMLElement>(".hero-portrait__frame");
const status=document.querySelector<HTMLElement>("[data-identity-status]");
const binary=document.querySelector<HTMLElement>(".hero-portrait__binary");

const hero=document.querySelector<HTMLElement>("#hero");
if(hero) hero.classList.add("is-cinematic");
const addStage=(name:string)=>hero?.classList.add(name);
const startReveal=()=>{ hero?.classList.add("is-revealed","is-hero-stage"); };
if(hero){
  const seen=(()=>{try{return sessionStorage.getItem("guruverse-intro-seen")==="true"}catch{return false}})();
  if(seen) window.setTimeout(startReveal,40);
  // Safety reveal: never leave the identity panel looking like an empty screen
  // if an intro event is interrupted or session state is stale.
  window.setTimeout(() => {
    if(hero && !hero.classList.contains("is-hero-stage")) startReveal();
  }, 3200);
  window.addEventListener("guruverse:portrait-build-start",()=>addStage("is-portrait-stage"),{once:true});
  window.addEventListener("guruverse:identity-scan",()=>addStage("is-scan-stage"),{once:true});
  window.addEventListener("guruverse:identity-verified",()=>addStage("is-verified-stage"),{once:true});
  window.addEventListener("guruverse:hero-lock",startReveal,{once:true});
  window.addEventListener("guruverse:intro-complete",startReveal,{once:true});
}
if(portrait&&canvas&&frame){
  const ctx=canvas.getContext("2d",{willReadFrequently:true});
  const build=()=>{
    if(!ctx||!portrait.naturalWidth)return;
    const rect=frame.getBoundingClientRect();
    const w=Math.max(180,Math.floor(rect.width)),h=Math.max(225,Math.floor(rect.height));
    canvas.width=w;canvas.height=h;
    const sample=document.createElement("canvas");sample.width=96;sample.height=Math.round(96*h/w);
    const sc=sample.getContext("2d",{willReadFrequently:true});if(!sc)return;
    sc.drawImage(portrait,0,0,sample.width,sample.height);
    const data=sc.getImageData(0,0,sample.width,sample.height).data;
    const points:{x:number;y:number;glyph:string;alpha:number}[]=[];
    const sx=w/sample.width,sy=h/sample.height;
    for(let y=0;y<sample.height;y+=2){for(let x=0;x<sample.width;x+=2){
      const i=(y*sample.width+x)*4,l=.2126*data[i]+.7152*data[i+1]+.0722*data[i+2];
      if(l>38)points.push({x:(x+.5)*sx,y:(y+.5)*sy,glyph:((x+y)&1)?"1":"0",alpha:Math.min(1,(l-28)/150)});
    }}
    const reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const startTime=performance.now();
    const duration=reduce?1:2450;
    const animate=(now:number)=>{
      const p=Math.min(1,(now-startTime)/duration);
      const eased=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;
      ctx.clearRect(0,0,w,h);
      ctx.textAlign="center";ctx.textBaseline="middle";
      for(const point of points){
        const spread=reduce?0:Math.max(0,1-eased);
        const seed=Math.sin(point.x*12.9898+point.y*78.233)*43758.5453;
        const rand=seed-Math.floor(seed);
        const x=point.x+(rand-.5)*w*.8*spread;
        const y=point.y+(1-rand-.5)*h*.65*spread;
        const twinkle=.72+.28*Math.sin(now*.008+point.x*.03);
        ctx.globalAlpha=point.alpha*(.18+.82*eased)*twinkle;
        ctx.fillStyle=point.alpha>.72?"#eaffff":point.alpha>.4?"#00e5ff":"#7c4dff";
        ctx.font=`${Math.max(5,Math.round(sx*.9))}px monospace`;
        ctx.fillText(point.glyph,x,y);
      }
      ctx.globalAlpha=1;
      if(p<1)requestAnimationFrame(animate);
      else {
        frame.classList.add("is-identity-built");
        if(status)status.textContent="IDENTITY VERIFIED · GURU CHARAN MAVUDURU";
        window.dispatchEvent(new CustomEvent("guruverse:portrait-built"));
      }
    };
    requestAnimationFrame(animate);
  };

  let started=false;
  const startBuild=()=>{if(started)return;started=true;build();};
  window.addEventListener("guruverse:portrait-build-start",startBuild,{once:true});
  window.addEventListener("guruverse:hero-lock",startBuild,{once:true});
  const seen=(()=>{try{return sessionStorage.getItem("guruverse-intro-seen")==="true"}catch{return false}})();
  if(seen){
    if(portrait.complete) window.setTimeout(startBuild,60);
    else portrait.addEventListener("load",()=>window.setTimeout(startBuild,60),{once:true});
  }
  window.addEventListener("resize",()=>{if(started)build()},{passive:true});
}
if(binary){binary.textContent=Array.from({length:42},(_,i)=>`${(i%2)?"1":"0"}${((i*7)%2)?"0":"1"}${((i*3)%2)?"1":"0"}`).join(" · ");}
</script>