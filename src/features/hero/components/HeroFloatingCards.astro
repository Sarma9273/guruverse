---
const technologies = [

    "Artificial Intelligence",
    "Cybersecurity",
    "Python",
    "RAG",
    "Splunk",
    "Research",
    "Cloud",
    "Software Engineering"

];
---

<div class="hero-floating">

    {

        technologies.map(technology => (

            <span class="hero-floating__card">

                {technology}

            </span>

        ))

    }

</div>