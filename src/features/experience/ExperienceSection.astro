---
import "./styles/experience.css";
import { experiences } from "./data/experience";
import ExperienceCard from "./components/ExperienceCard.astro";
---
<section id="experience" class="experience" aria-labelledby="experience-title"><div class="experience__container"><header class="experience__header"><span>PROFESSIONAL PRACTICE</span><h2 id="experience-title">Where the engineering becomes useful.</h2><p>Teaching, training and technical work form another layer of the journey: turning concepts into explanations, systems and practical learning.</p></header><div class="experience__grid">{experiences.map(experience=><ExperienceCard experience={experience}/>)}</div></div></section>