---
import type { Experience } from "../data/experience";

interface Props{

    experience:Experience;

}

const{

    experience

}=Astro.props;
---

<article class="experience-card">

    <span class="experience-card__duration">

        {experience.duration}

    </span>

   
    {
        experience.duration.includes("Present") && (

            <span class="experience-card__current">

                ● Current

            </span>

        )
    }

    
    <div class="experience-card__company">

    <div class="experience-card__icon">

        {experience.company.charAt(0)}

    </div>

    <div>

        <h3>

            {experience.company}

        </h3>

        <h4>

            {experience.role}

        </h4>

    </div>

</div>

    <p class="experience-card__location">

        {experience.location}

    </p>

    <p class="experience-card__description">

        {experience.description}

    </p>

    <div class="experience-card__tech">

        {

            experience.technologies.map(

                technology=>(

                    <span>

                        {technology}

                    </span>

                )

            )

        }

    </div>

</article>
