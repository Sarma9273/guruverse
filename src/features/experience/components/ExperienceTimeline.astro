---
import type { Experience } from "../data/experience";

interface Props{

    experience:Experience;

}

const{

    experience

}=Astro.props;
---

<article class="experience-card">

    <span class="experience-card__duration">

        {experience.duration}

    </span>

    <h3>

        {experience.company}

    </h3>

    <h4>

        {experience.role}

    </h4>

    <p class="experience-card__location">

        {experience.location}

    </p>

    <p class="experience-card__description">

        {experience.description}

    </p>

    <div class="experience-card__tech">

        {

            experience.technologies.map(

                tech=>(

                    <span>

                        {tech}

                    </span>

                )

            )

        }

    </div>

</article>