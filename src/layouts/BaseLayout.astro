---
import "../styles/globals.css";

interface Props {

    title?: string;

    description?: string;

}

const {

    title = "GURUVERSE",

    description = "Interactive AI Engineering Universe"

} = Astro.props;
---

<!doctype html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <meta
        name="theme-color"
        content="#04070D"
    />

</head>

<body>

    <slot />

</body>

</html>

<style is:global>

body{

    padding-top:var(--navbar-height);

}

</style>