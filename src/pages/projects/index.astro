---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../features/projects/data/projects";
import ProjectCard from "../../features/projects/components/ProjectCard.astro";
---

<BaseLayout
    title="Projects — GURUVERSE"
    description="Explore the AI, cybersecurity, software engineering, and research projects built within GURUVERSE."
>

    <main class="projects-page">

        <section class="projects-page__hero">

            <div class="projects-page__hero-content">

                <span class="projects-page__eyebrow">
                    PROJECT UNIVERSE
                </span>

                <h1>
                    Engineering Through
                    <span>Projects</span>
                </h1>

                <p>
                    Explore the systems, experiments, and engineering
                    work behind GURUVERSE — spanning artificial intelligence,
                    cybersecurity, software engineering, and research.
                </p>

            </div>

        </section>


        <section class="projects-page__content">

            <div class="projects-page__header">

                <div>

                    <span class="projects-page__section-label">
                        FEATURED WORK
                    </span>

                    <h2>
                        Built Systems
                    </h2>

                </div>

                <p>
                    {projects.length} projects
                </p>

            </div>


            <div class="projects-page__grid">

                {
                    projects.map((project) => (
                        <ProjectCard
                            project={project}
                        />
                    ))
                }

            </div>

        </section>

    </main>

</BaseLayout>


<style>

    .projects-page {
        min-height: 100vh;
        background: var(--color-background);
    }


    .projects-page__hero {
        position: relative;

        padding:
            clamp(120px, 16vw, 200px)
            var(--container-padding)
            clamp(80px, 10vw, 140px);

        overflow: hidden;
    }


    .projects-page__hero::before {
        content: "";

        position: absolute;

        width: 500px;
        height: 500px;

        top: -200px;
        left: 50%;

        transform: translateX(-50%);

        background:
            radial-gradient(
                circle,
                var(--color-primary),
                transparent 70%
            );

        opacity: 0.08;

        pointer-events: none;
    }


    .projects-page__hero-content {
        position: relative;
        z-index: 1;

        max-width: 900px;

        margin: 0 auto;

        text-align: center;
    }


    .projects-page__eyebrow {
        display: inline-block;

        margin-bottom: 24px;

        color: var(--color-primary);

        font-family: var(--font-code);

        font-size: 0.8rem;

        font-weight: 600;

        letter-spacing: 0.18em;
    }


    .projects-page__hero h1 {
        margin: 0;

        font-size:
            clamp(3rem, 8vw, 6rem);

        line-height: 1.05;
    }


    .projects-page__hero h1 span {
        display: block;

        color: var(--color-primary);
    }


    .projects-page__hero p {
        max-width: 760px;

        margin: 32px auto 0;

        color: var(--color-text-muted);

        font-size:
            clamp(1rem, 2vw, 1.2rem);

        line-height: 1.8;
    }


    .projects-page__content {
        width:
            min(
                var(--container-width),
                calc(
                    100% -
                    (var(--container-padding) * 2)
                )
            );

        margin: 0 auto;

        padding-bottom: 120px;
    }


    .projects-page__header {
        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 32px;

        margin-bottom: 48px;
    }


    .projects-page__section-label {
        color: var(--color-primary);

        font-family: var(--font-code);

        font-size: 0.75rem;

        letter-spacing: 0.16em;
    }


    .projects-page__header h2 {
        margin-top: 8px;
    }


    .projects-page__header > p {
        color: var(--color-text-muted);

        font-family: var(--font-code);

        font-size: 0.85rem;

        white-space: nowrap;
    }


    .projects-page__grid {
        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(
                    min(100%, 340px),
                    1fr
                )
            );

        gap: 32px;
    }


    @media (max-width: 700px) {

        .projects-page__header {
            align-items: flex-start;

            flex-direction: column;

            gap: 12px;
        }

    }

</style>